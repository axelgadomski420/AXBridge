// ============================================================
// AXBridge Ultra
// Muzyka • Tłumaczenie na żywo • TikTak • Społeczności
// Persona-aware • Puter.js + Hugging Face + więcej
// Admin: axelgadomski@icloud.com
// Backend target: Cloudflare Workers (D1 + R2 + KV + AI)
// ============================================================

app "AXBridge"
version "1.2.0-ultra"
language pl
supports ios android web
orientation automatic
offline first

// ------------------------------------------------------------
// THEME
// ------------------------------------------------------------
theme default
  follows system
  color primary #7C3AED
  color primaryDark #6D28D9
  color accent #06B6D4
  color danger #DC2626
  color success #16A34A
  color warning #D97706
  color background light #FAFAFA
  color background dark #0A0A0B
  color surface light #FFFFFF
  color surface dark #18181B
  color surface2 light #F4F4F5
  color surface2 dark #27272A
  color text light #09090B
  color text dark #FAFAFA
  color muted light #71717A
  color muted dark #A1A1AA
  color border light #E4E4E7
  color border dark #3F3F46
  radius small 8
  radius medium 14
  radius large 22
  radius full 999
  font body "Inter"
  font mono "JetBrains Mono"
  font display "Inter"
  shadow soft 0 1 3 #00000014
  shadow medium 0 4 14 #00000022

style title
  font size 28
  weight bold

style heading
  font size 20
  weight semibold

style body
  font size 16

style caption
  font size 13
  color muted

style mono
  font mono
  font size 14

style buttonPrimary
  background primary
  color white
  radius medium
  padding 16 20
  weight semibold

style buttonSecondary
  background surface2
  color text
  radius medium
  padding 14 18

style buttonDanger
  background danger
  color white
  radius medium
  padding 16 20

style card
  background surface
  radius medium
  padding 16
  shadow soft

// ------------------------------------------------------------
// DATA MODELS
// ------------------------------------------------------------
data User
  id Text
  publicId Text
  email Text?
  displayName Text
  avatarUrl Text?
  publicKey Text
  persona Text              // deaf | mute | deafMute | blind | deafBlind | motor | general
  preferredLang Text        // pl | en | auto
  isAdmin Boolean
  createdAt Date
  lastSeen Date?
  bio Text?

data Contact
  id Text
  user User
  displayName Text
  verified Boolean
  safetyNumber Text?
  canReceiveAlarm Boolean
  preferredLang Text?
  addedAt Date

data Conversation
  id Text
  type Text                 // direct | group | community
  participants List<User>
  title Text?
  lastMessage Message?
  unreadCount Number
  isPinned Boolean
  isMuted Boolean
  translationEnabled Boolean
  updatedAt Date

data Message
  id Text
  conversationId Text
  senderId Text
  type Text                 // text | voice | morse | sign | image | video | music | reaction | system | alarm
  body Text
  originalLang Text?
  translatedBody Text?
  translatedLang Text?
  mediaUrl Text?
  mediaMime Text?
  durationMs Number?
  confidence Number?
  musicMeta MusicMeta?
  replyToId Text?
  createdAt Date
  status Text
  isEncrypted Boolean

data MusicMeta
  title Text
  artist Text?
  provider Text             // suno | puter | huggingface | local | upload
  prompt Text?
  durationMs Number
  mood Text?               // happy | calm | energetic | sad | funny | love | angry
  isGenerated Boolean
  fileHash Text?

data AccessibilityProfile
  preferredInput Text
  preferredOutput Text
  morseWpm Number
  vibrationStrength Number
  textScale Number
  highContrast Boolean
  reduceMotion Boolean
  ttsVoice Text
  ttsRate Number
  autoTranslate Boolean
  showOriginalAndTranslation Boolean
  confirmBeforeSend Boolean
  showConfidence Boolean
  largeTargets Boolean
  musicAsEmotion Boolean

data Community
  id Text
  name Text
  description Text
  coverUrl Text?
  memberCount Number
  isPrivate Boolean
  createdAt Date
  ownerId Text

data TikTakPost
  id Text
  author User
  mediaUrl Text
  mediaType Text            // video | audio | image | music
  caption Text
  mood Text?
  likes Number
  comments Number
  createdAt Date
  isFunny Boolean

data ProviderConfig
  id Text
  name Text
  type Text                 // llm | music | stt | tts | translate | image
  baseUrl Text?
  apiKey Text?              // przechowywane lokalnie zaszyfrowane
  enabled Boolean
  isDefault Boolean
  priority Number
  notes Text?

data AppSettings
  themeMode Text
  language Text
  autoTranslate Boolean
  defaultTargetLang Text
  musicProvider Text
  llmProvider Text
  translateProvider Text
  notificationsEnabled Boolean
  analyticsEnabled Boolean

// ------------------------------------------------------------
// STORES
// ------------------------------------------------------------
store profile local
  single AccessibilityProfile
  key "axbridge.profile.v2"

store user local
  single User
  key "axbridge.user.v2"

store contacts local
  list Contact
  key "axbridge.contacts.v2"

store conversations local
  list Conversation
  key "axbridge.conversations.v2"

store messages local
  list Message
  key "axbridge.messages.v2"

store communities local
  list Community
  key "axbridge.communities.v2"

store tiktak local
  list TikTakPost
  key "axbridge.tiktak.v2"

store providers local
  list ProviderConfig
  key "axbridge.providers.v2"
  encrypted true

store settings local
  single AppSettings
  key "axbridge.settings.v2"

store musicCache local
  list MusicMeta
  key "axbridge.music.v2"

// ------------------------------------------------------------
// GLOBAL STATE
// ------------------------------------------------------------
global state currentUser User? = none
global state isLoggedIn Boolean = false
global state isOnline Boolean = true
global state activeConversation Conversation? = none
global state isAdminMode Boolean = false
global state currentPersona Text = "general"
global state translationOn Boolean = true
global state activeMusic MusicMeta? = none
global state isPlayingMusic Boolean = false

// ------------------------------------------------------------
// DEFAULT PROVIDERS (Puter.js główny + lista)
// ------------------------------------------------------------
function seedProviders()
  if providers is empty
    add ProviderConfig(id="puter", name="Puter.js", type="llm", enabled=true, isDefault=true, priority=1, notes="Główny provider — darmowy, bez klucza") to providers
    add ProviderConfig(id="puter-music", name="Puter.js Music", type="music", enabled=true, isDefault=true, priority=1) to providers
    add ProviderConfig(id="hf", name="Hugging Face", type="llm", enabled=false, priority=2, notes="Wymaga tokenu HF") to providers
    add ProviderConfig(id="hf-music", name="Hugging Face MusicGen", type="music", enabled=false, priority=2) to providers
    add ProviderConfig(id="suno", name="Suno v6", type="music", enabled=true, priority=1, notes="Najwyższa jakość generowania muzyki") to providers
    add ProviderConfig(id="openai", name="OpenAI", type="llm", enabled=false, priority=3) to providers
    add ProviderConfig(id="anthropic", name="Anthropic Claude", type="llm", enabled=false, priority=3) to providers
    add ProviderConfig(id="groq", name="Groq", type="llm", enabled=false, priority=4) to providers
    add ProviderConfig(id="deepl", name="DeepL", type="translate", enabled=true, priority=1) to providers
    add ProviderConfig(id="google-translate", name="Google Translate", type="translate", enabled=false, priority=2) to providers
    add ProviderConfig(id="whisper", name="Whisper (local/HF)", type="stt", enabled=true, priority=1) to providers
    add ProviderConfig(id="elevenlabs", name="ElevenLabs", type="tts", enabled=false, priority=2) to providers
    add ProviderConfig(id="local-tts", name="System TTS", type="tts", enabled=true, isDefault=true, priority=1) to providers
    save providers

// ------------------------------------------------------------
// ONBOARDING + PERSONA
// ------------------------------------------------------------
screen Onboarding
  title "AXBridge"

  state step Number = 1

  column
    padding 24
    gap 24
    align center

    if step is 1
      column
        gap 18
        align center
        image "logo-axbridge.svg"
          width 88
          height 88
          alt "AXBridge"
        text "AXBridge"
          style title
        text "Komunikator dla każdego. Tekst, mowa, Morse, migowy, muzyka i zabawa."
          color muted
          align center
          max width 300
        button "Zaczynamy"
          style buttonPrimary
          width full
          height 56
          when tapped set step = 2

    if step is 2
      column
        gap 16
        text "Kim jesteś?"
          style heading
          align center
        text "Dzięki temu aplikacja od razu ustawi najlepsze domyślne opcje."
          color muted
          align center

        button "Głuchy / Głucha"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deaf"
            set profile.preferredInput = "sign"
            set profile.preferredOutput = "text"
            set step = 3

        button "Niemy / Niema"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "mute"
            set profile.preferredInput = "text"
            set profile.preferredOutput = "speech"
            set step = 3

        button "Głuchoniemy / Głuchoniema"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deafMute"
            set profile.preferredInput = "sign"
            set profile.preferredOutput = "text"
            set step = 3

        button "Niewidomy / Niewidoma"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "blind"
            set profile.preferredInput = "speech"
            set profile.preferredOutput = "speech"
            set profile.musicAsEmotion = true
            set step = 3

        button "Głuchoniewidomy"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deafBlind"
            set profile.preferredInput = "morse"
            set profile.preferredOutput = "morse"
            set step = 3

        button "Ograniczona sprawność ruchowa"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "motor"
            set profile.largeTargets = true
            set step = 3

        button "Ogólny / Chcę wszystko"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "general"
            set step = 3

    if step is 3
      column
        gap 16
        text "Język i tłumaczenie"
          style heading
        text "Piszesz po polsku — kolega ze Stanów dostaje od razu po angielsku (i odwrotnie)."
          color muted

        segmented settings.defaultTargetLang
          options pl, en, auto
          labels "Polski", "English", "Auto"

        toggle profile.autoTranslate
          label "Tłumacz wiadomości automatycznie"

        toggle profile.showOriginalAndTranslation
          label "Pokazuj oryginał + tłumaczenie"

        button "Dalej"
          style buttonPrimary
          width full
          height 56
          when tapped
            save profile
            save settings
            set step = 4

    if step is 4
      column
        gap 16
        align center
        text "Muzyka jako emocja"
          style heading
        text "Możesz wysyłać utwory, generować muzykę (Suno v6 / Puter) i używać jej jako reakcji emocjonalnej."
          color muted
          align center
        toggle profile.musicAsEmotion
          label "Włącz muzykę jako kanał emocji"
        button "Przejdź do rejestracji"
          style buttonPrimary
          width full
          height 56
          when tapped
            seedProviders()
            go to Register

// ------------------------------------------------------------
// REGISTER / LOGIN
// ------------------------------------------------------------
screen Register
  title "Rejestracja"

  state displayName Text = ""
  state email Text = ""
  state password Text = ""
  state error Text = ""
  state isWorking Boolean = false

  column
    padding 24
    gap 16

    text "Utwórz konto"
      style title

    field displayName
      label "Pseudonim"
      required
      min length 2
      placeholder "Jak mamy Cię wyświetlać?"

    field email
      label "E-mail"
      type email
      required
      placeholder "jan@email.com"

    field password
      label "Hasło"
      type password
      required
      min length 8
      error "Minimum 8 znaków"

    if error is not empty
      text error
        color danger
        role alert

    button "Zarejestruj się"
      style buttonPrimary
      width full
      height 56
      disabled isWorking
      when tapped
        if displayName is empty or email is empty or password is empty
          set error = "Uzupełnij wszystkie pola"
        else
          set isWorking = true
          // rejestracja + generacja kluczy E2EE
          set currentUser = User(
            id = newId(),
            publicId = "AXB-" + randomCode(6),
            email = email,
            displayName = displayName,
            publicKey = "pk_" + newId(),
            persona = currentPersona,
            preferredLang = "pl",
            isAdmin = (email is "axelgadomski@icloud.com"),
            createdAt = now()
          )
          set isLoggedIn = true
          set isAdminMode = currentUser.isAdmin
          save user
          set isWorking = false
          go to Conversations

    button "Mam już konto — zaloguj się"
      style buttonSecondary
      when tapped
        go to Login

screen Login
  title "Logowanie"
  state email Text = ""
  state password Text = ""
  state error Text = ""

  column
    padding 24
    gap 16
    text "Zaloguj się"
      style title
    field email
      label "E-mail"
      type email
    field password
      label "Hasło"
      type password
    if error is not empty
      text error color danger
    button "Zaloguj"
      style buttonPrimary
      width full
      height 56
      when tapped
        // auth + załadowanie usera
        // jeśli email == axelgadomski@icloud.com → isAdmin = true
        go to Conversations
    button "Nie mam konta"
      when tapped go to Register

// ------------------------------------------------------------
// GŁÓWNY TAB BAR
// ------------------------------------------------------------
screen MainTabs
  tab Conversations title "Rozmowy" icon "chat"
  tab Communities title "Społeczności" icon "people"
  tab TikTak title "TikTak" icon "sparkles"
  tab MusicHub title "Muzyka" icon "music"
  tab ProfileHub title "Profil" icon "person"

// ------------------------------------------------------------
// CONVERSATIONS + TŁUMACZENIE NA ŻYWO
// ------------------------------------------------------------
screen Conversations
  title "Rozmowy"

  when screen appears
    load conversations
    load contacts
    load providers

  column
    row
      padding 16
      text "AXBridge"
        style title
      spacer
      button icon "search"
      button icon "settings"
        when tapped go to SettingsHub
      button icon "alert"
        color danger
        when tapped go to Emergency

    list conversations
      empty
        column
          padding 40
          align center
          text "Brak rozmów"
            style heading
          text "Dodaj kontakt albo dołącz do społeczności."
            color muted
          button "Dodaj kontakt"
            style buttonPrimary
            when tapped go to AddContact
      item conv
        conversationRow conv
          when tapped
            set activeConversation = conv
            go to Chat(conv)

component conversationRow(conv Conversation)
  card
    row
      gap 12
      avatar conv.participants.first
      column
        text conv.participants.first.displayName style heading
        if conv.lastMessage is not none
          text previewMessage(conv.lastMessage) color muted max lines 1
      spacer
      if conv.unreadCount > 0
        badge conv.unreadCount

// ------------------------------------------------------------
// CHAT z tłumaczeniem + muzyką
// ------------------------------------------------------------
screen Chat(conversation Conversation)
  title conversation.participants.first.displayName

  state inputMode Text = profile.preferredInput
  state draft Text = ""
  state morseBuffer Text = ""
  state isRecording Boolean = false
  state showMusicPicker Boolean = false
  state replyTo Message? = none

  when screen appears
    load messages where conversationId = conversation.id

  column
    // header
    row
      padding 8 12
      button icon "back" when tapped go back
      avatar conversation.participants.first size 36
      column
        text conversation.participants.first.displayName style heading
        text if translationOn then "Tłumaczenie włączone" else "Tłumaczenie wyłączone"
          style caption
          color if translationOn then success else muted
      spacer
      toggle translationOn
        accessibility label "Włącz/wyłącz tłumaczenie na żywo"

    // messages
    list messages where conversationId = conversation.id
      reverse true
      item msg
        messageBubble msg

    // input modes
    row
      padding 6 10
      gap 6
      modeChip "Tekst" "text"
      modeChip "Mowa" "speech"
      modeChip "Morse" "morse"
      modeChip "Migowy" "sign"
      modeChip "Muzyka" "music"

    // TEXT + auto translate
    if inputMode is "text"
      row
        padding 8 12
        gap 8
        field draft
          label "Wiadomość"
          placeholder "Napisz po polsku…"
          multiline
          grow true
        button icon "send"
          disabled draft is empty
          when tapped
            sendTranslatedText(draft, replyTo)
            set draft = ""
            set replyTo = none

    // MUSIC INPUT
    if inputMode is "music"
      column
        padding 12
        gap 10
        text "Muzyka jako wiadomość / emocja"
          style heading
        button "Generuj muzykę (Suno v6 / Puter)"
          style buttonPrimary
          width full
          height 52
          when tapped go to MusicGenerator
        button "Wybierz z pliku"
          style buttonSecondary
          width full
          when tapped pickMusicFileAndSend()
        button "Szybkie reakcje emocjonalne"
          style buttonSecondary
          width full
          when tapped showMusicReactions()
        button "Anuluj"
          when tapped set inputMode = "text"

    // MORSE (skrócone)
    if inputMode is "morse"
      column
        padding 12
        gap 8
        text morseBuffer style mono font size 20
        row
          button "·" height 56 grow true when tapped append "." to morseBuffer
          button "−" height 56 grow true when tapped append "-" to morseBuffer
          button "␣" height 56 grow true when tapped append " " to morseBuffer
          button "⌫" height 56 when tapped remove last from morseBuffer
        button "Wyślij Morse"
          style buttonPrimary
          when tapped
            sendMorse(morseBuffer, replyTo)
            set morseBuffer = ""

    // SIGN (skrócone z pewnością)
    if inputMode is "sign"
      column
        padding 12
        gap 10
        cameraPreview height 220
        button "Rozpoznaj znak"
          style buttonPrimary
          width full
          when tapped runSignRecognition()

component messageBubble(msg Message)
  column
    padding 4 12
    align if msg.senderId is currentUser.id then end else start
    max width 85%

    card
      padding 10 14
      background if msg.senderId is currentUser.id then primary else surface2
      color if msg.senderId is currentUser.id then white else text

      if msg.type is "text"
        column
          gap 4
          text msg.body
          if msg.translatedBody is not none and profile.showOriginalAndTranslation
            text msg.translatedBody
              style caption
              opacity 0.9
              color if msg.senderId is currentUser.id then white else accent

      if msg.type is "music"
        column
          gap 6
          row
            icon "music"
            text msg.musicMeta.title weight semibold
          if msg.musicMeta.mood is not none
            text "Nastrój: " + msg.musicMeta.mood style caption
          button "Odtwórz"
            when tapped playMusic(msg.musicMeta)

      if msg.type is "morse"
        text msg.body style mono

      if msg.type is "sign"
        column
          text msg.body weight semibold
          if msg.confidence is not none
            text "Pewność " + round(msg.confidence*100) + "%" style caption

    text formatTime(msg.createdAt) style caption

// ------------------------------------------------------------
// MUSIC HUB + GENERATOR (Suno v6 / Puter)
// ------------------------------------------------------------
screen MusicHub
  title "Muzyka"

  column
    padding 16
    gap 16

    text "Muzyka jako komunikat"
      style title

    button "Generuj nowy utwór"
      style buttonPrimary
      width full
      height 56
      when tapped go to MusicGenerator

    button "Moje wygenerowane"
      style buttonSecondary
      width full
      when tapped go to MyMusic

    button "Odtwarzaj z pliku"
      style buttonSecondary
      width full
      when tapped pickAndPlayLocalMusic()

    text "Szybkie reakcje emocjonalne"
      style heading

    row
      gap 8
      musicReaction "😊" "happy"
      musicReaction "😌" "calm"
      musicReaction "⚡" "energetic"
      musicReaction "😢" "sad"
      musicReaction "😂" "funny"
      musicReaction "❤️" "love"

screen MusicGenerator
  title "Generator muzyki"

  state prompt Text = ""
  state mood Text = "happy"
  state isGenerating Boolean = false
  state result MusicMeta? = none
  state selectedProvider Text = "suno"

  column
    padding 16
    gap 14

    text "Opisz utwór (Suno v6 / Puter.js / HF MusicGen)"
      style heading

    field prompt
      label "Prompt"
      placeholder "Wesoła ukulele melodia na powitanie przyjaciela"
      multiline
      max lines 4

    text "Nastrój"
    segmented mood
      options happy, calm, energetic, sad, funny, love, angry
      labels "Wesoły", "Spokojny", "Energiczny", "Smutny", "Zabawny", "Miłosny", "Gniewny"

    text "Dostawca"
    segmented selectedProvider
      options suno, puter, huggingface
      labels "Suno v6", "Puter.js", "Hugging Face"

    button if isGenerating then "Generuję…" else "Generuj muzykę"
      style buttonPrimary
      width full
      height 56
      disabled prompt is empty or isGenerating
      when tapped
        set isGenerating = true
        generateMusic(prompt, mood, selectedProvider)
        set isGenerating = false

    if result is not none
      card
        text result.title style heading
        text "Provider: " + result.provider style caption
        button "Odtwórz"
          when tapped playMusic(result)
        button "Wyślij jako wiadomość"
          style buttonPrimary
          when tapped
            sendMusicMessage(result)
            go back

// ------------------------------------------------------------
// TIKTAK — strona jak TikTok
// ------------------------------------------------------------
screen TikTak
  title "TikTak"

  when screen appears
    load tiktak

  column
    row
      padding 12 16
      text "TikTak"
        style title
      spacer
      button icon "plus"
        accessibility label "Dodaj nowy TikTak"
        when tapped go to CreateTikTak

    list tiktak
      empty
        column
          padding 48
          align center
          text "Jeszcze cicho…"
            style heading
          text "Wrzuć pierwszą głupotę i rozbaw innych."
            color muted
          button "Dodaj TikTak"
            style buttonPrimary
            when tapped go to CreateTikTak

      item post
        tiktakCard post

component tiktakCard(post TikTakPost)
  column
    gap 8
    padding 0 0 24 0

    // media
    if post.mediaType is "video" or post.mediaType is "image"
      image post.mediaUrl
        width full
        height 420
        radius medium
        alt post.caption

    if post.mediaType is "music" or post.mediaType is "audio"
      card
        height 180
        align center
        icon "music" size 48
        text post.caption
        button "Odtwórz" when tapped playMusicFromPost(post)

    // author + caption
    row
      padding 0 12
      avatar post.author size 32
      column
        text post.author.displayName weight semibold
        text post.caption max lines 2

    // actions
    row
      padding 4 12
      gap 18
      button icon "heart" label post.likes
      button icon "message" label post.comments
      button icon "share"
      spacer
      if post.isFunny
        text "😂" font size 20

screen CreateTikTak
  title "Nowy TikTak"
  state caption Text = ""
  state mediaType Text = "video"
  state isFunny Boolean = true

  column
    padding 16
    gap 14
    field caption
      label "Opis"
      placeholder "Coś głupiego i zabawnego…"
      multiline
    segmented mediaType
      options video, image, music, audio
      labels "Wideo", "Zdjęcie", "Muzyka", "Audio"
    toggle isFunny
      label "To jest głupotka / zabawa"
    button "Wybierz plik / nagraj"
      style buttonSecondary
      width full
      when tapped pickTikTakMedia(mediaType)
    button "Opublikuj"
      style buttonPrimary
      width full
      height 56
      when tapped
        publishTikTak(caption, mediaType, isFunny)
        go to TikTak

// ------------------------------------------------------------
// COMMUNITIES
// ------------------------------------------------------------
screen Communities
  title "Społeczności"

  column
    padding 16
    gap 12
    button "Utwórz społeczność"
      style buttonPrimary
      width full
      when tapped go to CreateCommunity

    list communities
      empty
        text "Brak społeczności. Stwórz pierwszą!"
          color muted
      item c
        card
          when tapped go to CommunityDetail(c)
          text c.name style heading
          text c.description color muted max lines 2
          text c.memberCount + " członków" style caption

// ------------------------------------------------------------
// SETTINGS HUB + PROVIDERS (przewijana lista)
// ------------------------------------------------------------
screen SettingsHub
  title "Ustawienia"

  column
    padding 8
    settingsItem "person" "Profil i persona" currentUser.displayName
      when tapped go to ProfileHub
    settingsItem "accessibility" "Dostępność" "Kanały, Morse, tekst"
      when tapped go to AccessibilitySettings
    settingsItem "globe" "Język i tłumaczenie" "PL ↔ EN na żywo"
      when tapped go to TranslationSettings
    settingsItem "music" "Muzyka" "Suno, Puter, pliki"
      when tapped go to MusicSettings
    settingsItem "server" "Dostawcy AI i API" "Puter.js, Hugging Face, Suno…"
      when tapped go to ProvidersSettings
    settingsItem "shield" "Bezpieczeństwo" "E2EE, klucze, admin"
      when tapped go to SecuritySettings
    settingsItem "bell" "Powiadomienia" ""
      when tapped go to NotificationSettings
    if isAdminMode
      settingsItem "crown" "Panel Admina" "axelgadomski@icloud.com"
        when tapped go to AdminPanel

screen ProvidersSettings
  title "Dostawcy API"

  column
    padding 12
    gap 8

    text "Wszystkie klucze i endpointy trzymane są lokalnie i zaszyfrowane. Główny domyślny: Puter.js."
      color muted
      padding 0 4 12 4

    // przewijana lista dostawców
    list providers
      item p
        card
          row
            column
              text p.name style heading
              text p.type + if p.notes is not none then " • " + p.notes else ""
                style caption
              if p.isDefault
                text "Domyślny" color success style caption
            spacer
            toggle p.enabled
              when changed value
                update p.enabled = value
                save providers

          if p.enabled and p.type is not "puter"
            field p.apiKey
              label "API Key / Token"
              type password
              placeholder "Wklej klucz…"
              when changed
                save providers

    button "Dodaj własnego dostawcę"
      style buttonSecondary
      width full
      when tapped go to AddProvider

    button "Przywróć listę domyślną"
      style buttonSecondary
      width full
      when tapped
        clear providers
        seedProviders()

screen TranslationSettings
  title "Tłumaczenie"
  column
    padding 16
    gap 12
    toggle profile.autoTranslate
      label "Automatyczne tłumaczenie w rozmowach"
    toggle profile.showOriginalAndTranslation
      label "Pokazuj oryginał + tłumaczenie"
    text "Domyślny język docelowy"
    segmented settings.defaultTargetLang
      options pl, en, auto
      labels "Polski", "English", "Auto"
    text "Dostawca tłumaczeń"
    // wybór z listy providers type=translate

screen MusicSettings
  title "Ustawienia muzyki"
  column
    padding 16
    gap 12
    toggle profile.musicAsEmotion
      label "Muzyka jako kanał emocji"
    text "Domyślny generator"
    segmented settings.musicProvider
      options suno, puter, huggingface
      labels "Suno v6", "Puter.js", "Hugging Face"
    button "Wyczyść cache muzyki"
      style buttonSecondary
      when tapped clear musicCache

// ------------------------------------------------------------
// ADMIN PANEL (tylko axelgadomski@icloud.com)
// ------------------------------------------------------------
screen AdminPanel
  title "Panel Admina"

  column
    padding 16
    gap 12
    text "Zalogowany jako admin"
      style heading
    text "axelgadomski@icloud.com"
      style mono
      color muted

    button "Przegląd użytkowników"
      style buttonSecondary
      width full
    button "Moderacja TikTak"
      style buttonSecondary
      width full
    button "Moderacja społeczności"
      style buttonSecondary
      width full
    button "Logi systemowe"
      style buttonSecondary
      width full
    button "Wymuś synchronizację D1 / R2"
      style buttonSecondary
      width full
    button "Wyślij komunikat globalny"
      style buttonPrimary
      width full

// ------------------------------------------------------------
// PROFILE + AVATAR
// ------------------------------------------------------------
screen ProfileHub
  title "Profil"

  column
    padding 20
    gap 16
    align center

    // zdjęcie profilowe
    button
      when tapped changeAvatar()
      circle
        size 104
        background primary
        if currentUser.avatarUrl is not none
          image currentUser.avatarUrl
            width 104
            height 104
            radius full
            alt "Zdjęcie profilowe"
        else
          text left(currentUser.displayName, 1)
            color white
            font size 40
            weight bold

    text currentUser.displayName style title
    text currentUser.publicId style mono color muted
    text "Persona: " + personaLabel(currentUser.persona) style caption

    button "Zmień zdjęcie profilowe"
      style buttonSecondary
      width full
      when tapped changeAvatar()

    button "Edytuj profil"
      style buttonSecondary
      width full

    button "Wyloguj"
      style buttonSecondary
      width full
      when tapped logout()

// ------------------------------------------------------------
// HELPERS — tłumaczenie, muzyka, avatar, itd.
// ------------------------------------------------------------
function sendTranslatedText(body Text, reply Message?)
  // 1. wykryj język
  // 2. jeśli autoTranslate → przetłumacz przez wybranego dostawcę (DeepL / Puter / HF)
  // 3. zapisz original + translated
  add Message(
    id = newId(),
    conversationId = activeConversation.id,
    senderId = currentUser.id,
    type = "text",
    body = body,
    originalLang = "pl",
    translatedBody = translate(body, settings.defaultTargetLang),
    translatedLang = settings.defaultTargetLang,
    createdAt = now(),
    status = "sent",
    isEncrypted = true
  ) to messages
  save messages

function translate(text Text, targetLang Text) returns Text
  // wywołanie wybranego providera tłumaczeń
  // domyślnie Puter.js lub DeepL
  return "[EN] " + text   // placeholder — w runtime prawdziwe API

function generateMusic(prompt Text, mood Text, provider Text)
  // Suno v6 / Puter.js / HF MusicGen
  // wynik trafia do result + musicCache + R2
  set result = MusicMeta(
    title = "Generated: " + left(prompt, 30),
    provider = provider,
    prompt = prompt,
    mood = mood,
    durationMs = 32000,
    isGenerated = true
  )
  add result to musicCache
  save musicCache

function sendMusicMessage(meta MusicMeta)
  add Message(
    id = newId(),
    conversationId = activeConversation.id,
    senderId = currentUser.id,
    type = "music",
    body = meta.title,
    musicMeta = meta,
    createdAt = now(),
    status = "sent",
    isEncrypted = true
  ) to messages
  save messages

function playMusic(meta MusicMeta)
  set activeMusic = meta
  set isPlayingMusic = true
  // odtwarzanie z R2 lub lokalnego cache

function changeAvatar()
  // wybór z galerii / aparat
  // upload do R2 (AL_BUCKET)
  // aktualizacja currentUser.avatarUrl

function personaLabel(p Text) returns Text
  if p is "deaf" return "Głuchy/Głucha"
  if p is "mute" return "Niemy/Niema"
  if p is "deafMute" return "Głuchoniemy"
  if p is "blind" return "Niewidomy/Niewidoma"
  if p is "deafBlind" return "Głuchoniewidomy"
  if p is "motor" return "Ograniczona sprawność ruchowa"
  return "Ogólny"

function previewMessage(msg Message) returns Text
  if msg.type is "text" return msg.body
  if msg.type is "music" return "🎵 " + msg.musicMeta.title
  if msg.type is "morse" return "Morse"
  if msg.type is "sign" return "Migowy: " + msg.body
  return "Wiadomość"

function publishTikTak(caption Text, mediaType Text, isFunny Boolean)
  add TikTakPost(
    id = newId(),
    author = currentUser,
    mediaUrl = "r2://placeholder",
    mediaType = mediaType,
    caption = caption,
    likes = 0,
    comments = 0,
    createdAt = now(),
    isFunny = isFunny
  ) to tiktak
  save tiktak

function logout()
  set currentUser = none
  set isLoggedIn = false
  set isAdminMode = false
  go to Login

function seedProviders()
  // zaimplementowane wyżej

// ------------------------------------------------------------
// START
// ------------------------------------------------------------
when app launches
  load user
  load profile
  load settings
  load providers
  if providers is empty
    seedProviders()
  if isLoggedIn and currentUser is not none
    set isAdminMode = currentUser.isAdmin
    go to MainTabs
  else
    go to Onboarding
