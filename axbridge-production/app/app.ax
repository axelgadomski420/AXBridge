    list communities
      empty
        text "Brak społeczności. Stwórz pierwszą!" color muted
      item c
        card
          when tapped go to CommunityDetail(c)
          text c.name style heading
          text c.description color muted max lines 2
          text c.memberCount + " członków" style caption

screen CreateCommunity
  title "Nowa społeczność"
