    id = newId(),
    author = currentUser,
    mediaUrl = "r2://placeholder",
    mediaType = mediaType,
    caption = caption,
    likes = 0,
    comments = 0,
    createdAt = now(),
    isFunny = isFunny
  ) to tiktak
  save tiktak

function addContactByCode(code Text)
