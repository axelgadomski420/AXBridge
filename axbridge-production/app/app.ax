// ============================================================
// AXBridge Ultra — Production Ready
// Muzyka • Tłumaczenie na żywo PL↔EN • TikTak • Społeczności
// Persona-aware • Puter.js + Suno v6 + Hugging Face + więcej
// Admin: axelgadomski@icloud.com
// Backend: Cloudflare Workers (D1 + R2 + KV + AI + Queue)
// Version: 1.3.0-production
// ============================================================

app "AXBridge"
version "1.3.0-production"
language pl
supports ios android web
orientation automatic
offline first

// ------------------------------------------------------------
// THEME & DESIGN TOKENS
// ------------------------------------------------------------
theme default
  follows system
  color primary #7C3AED
  color primaryDark #6D28D9
  color accent #06B6D4
  color danger #DC2626
  color success #16A34A
  color warning #D97706
  color background light #FAFAFA
  color background dark #0A0A0B
  color surface light #FFFFFF
  color surface dark #18181B
  color surface2 light #F4F4F5
  color surface2 dark #27272A
  color text light #09090B
  color text dark #FAFAFA
  color muted light #71717A
  color muted dark #A1A1AA
  color border light #E4E4E7
  color border dark #3F3F46
  color overlay #00000088
  radius small 8
  radius medium 14
  radius large 22
  radius full 999
  font body "Inter"
  font mono "JetBrains Mono"
  font display "Inter"
  shadow soft 0 1 3 #00000014
  shadow medium 0 4 14 #00000022
  shadow strong 0 8 24 #00000030

style title
  font size 28
  weight bold
  line height 1.2

style heading
  font size 20
  weight semibold

style body
  font size 16
  weight regular

style caption
  font size 13
  weight regular
  color muted

style mono
  font mono
  font size 15

style buttonPrimary
  background primary
  color white
  radius medium
  padding 16 20
  weight semibold

style buttonSecondary
  background surface2
  color text
  radius medium
  padding 14 18

style buttonDanger
  background danger
  color white
  radius medium
  padding 16 20
  weight semibold

style card
  background surface
  radius medium
  padding 16
  shadow soft

style input
  background surface2
  radius medium
  padding 14 16
  border 1 border

// ------------------------------------------------------------
// DATA MODELS
// ------------------------------------------------------------
data User
  id Text
  publicId Text
  email Text?
  displayName Text
  avatarUrl Text?
  publicKey Text
  persona Text
  preferredLang Text
  isAdmin Boolean
  createdAt Date
  lastSeen Date?
  bio Text?

data Contact
  id Text
  user User
  displayName Text
  verified Boolean
  safetyNumber Text?
  canReceiveAlarm Boolean
  preferredLang Text?
  addedAt Date
  lastMessageAt Date?

data Conversation
  id Text
  type Text
  participants List<User>
  title Text?
  lastMessage Message?
  unreadCount Number
  isPinned Boolean
  isMuted Boolean
  translationEnabled Boolean
  updatedAt Date
  createdAt Date

data Message
  id Text
  conversationId Text
  senderId Text
  type Text
  body Text
  originalLang Text?
  translatedBody Text?
  translatedLang Text?
  mediaUrl Text?
  mediaMime Text?
  durationMs Number?
  confidence Number?
  musicMeta MusicMeta?
  replyToId Text?
  createdAt Date
  status Text
  isEncrypted Boolean

data MusicMeta
  title Text
  artist Text?
  provider Text
  prompt Text?
  durationMs Number
  mood Text?
  isGenerated Boolean
  fileHash Text?
  r2Key Text?

data AccessibilityProfile
  preferredInput Text
  preferredOutput Text
  morseWpm Number
  vibrationStrength Number
  textScale Number
  highContrast Boolean
  reduceMotion Boolean
  ttsVoice Text
  ttsRate Number
  ttsPitch Number
  autoTranslate Boolean
  showOriginalAndTranslation Boolean
  confirmBeforeSend Boolean
  showConfidence Boolean
  largeTargets Boolean
  musicAsEmotion Boolean
  autoPlayIncoming Boolean
  screenReaderHints Boolean

data Community
  id Text
  name Text
  description Text
  coverUrl Text?
  memberCount Number
  isPrivate Boolean
  createdAt Date
  ownerId Text

data TikTakPost
  id Text
  author User
  mediaUrl Text
  mediaType Text
  caption Text
  mood Text?
  likes Number
  comments Number
  createdAt Date
  isFunny Boolean

data ProviderConfig
  id Text
  name Text
  type Text
  baseUrl Text?
  apiKey Text?
  enabled Boolean
  isDefault Boolean
  priority Number
  notes Text?

data AppSettings
  themeMode Text
  language Text
  autoTranslate Boolean
  defaultTargetLang Text
  musicProvider Text
  llmProvider Text
  translateProvider Text
  notificationsEnabled Boolean
  soundEnabled Boolean
  vibrationEnabled Boolean
  analyticsEnabled Boolean

data EmergencyEvent
  id Text
  initiatorId Text
  message Text
  locationShared Boolean
  latitude Number?
  longitude Number?
  expiresAt Date?
  status Text
  createdAt Date
  recipientIds List<Text>

// ------------------------------------------------------------
// LOCAL STORES (offline-first)
// ------------------------------------------------------------
store profile local
  single AccessibilityProfile
  key "axbridge.profile.v3"

store user local
  single User
  key "axbridge.user.v3"

store contacts local
  list Contact
  key "axbridge.contacts.v3"

store conversations local
  list Conversation
  key "axbridge.conversations.v3"

store messages local
  list Message
  key "axbridge.messages.v3"

store communities local
  list Community
  key "axbridge.communities.v3"

store tiktak local
  list TikTakPost
  key "axbridge.tiktak.v3"

store providers local
  list ProviderConfig
  key "axbridge.providers.v3"
  encrypted true

store settings local
  single AppSettings
  key "axbridge.settings.v3"

store musicCache local
  list MusicMeta
  key "axbridge.music.v3"

store emergencyHistory local
  list EmergencyEvent
  key "axbridge.emergency.v3"

// ------------------------------------------------------------
// GLOBAL STATE
// ------------------------------------------------------------
global state currentUser User? = none
global state isLoggedIn Boolean = false
global state isOnline Boolean = true
global state activeConversation Conversation? = none
global state isAdminMode Boolean = false
global state currentPersona Text = "general"
global state translationOn Boolean = true
global state activeMusic MusicMeta? = none
global state isPlayingMusic Boolean = false
global state isSyncing Boolean = false
global state lastError Text = ""
global state cameraPermission Text = "unknown"
global state microphonePermission Text = "unknown"
global state locationPermission Text = "unknown"

// ------------------------------------------------------------
// SEED PROVIDERS
// ------------------------------------------------------------
function seedProviders()
  if providers is empty
    add ProviderConfig(id="puter", name="Puter.js", type="llm", enabled=true, isDefault=true, priority=1, notes="Główny provider — darmowy, bez klucza") to providers
    add ProviderConfig(id="puter-music", name="Puter.js Music", type="music", enabled=true, isDefault=true, priority=1, notes="Generowanie muzyki przez Puter") to providers
    add ProviderConfig(id="suno", name="Suno v6", type="music", enabled=true, priority=1, notes="Najwyższa jakość generowania muzyki") to providers
    add ProviderConfig(id="hf", name="Hugging Face", type="llm", enabled=false, priority=2, notes="Wymaga tokenu HF") to providers
    add ProviderConfig(id="hf-music", name="Hugging Face MusicGen", type="music", enabled=false, priority=2, notes="MusicGen przez HF") to providers
    add ProviderConfig(id="openai", name="OpenAI", type="llm", enabled=false, priority=3, notes="GPT + Whisper") to providers
    add ProviderConfig(id="anthropic", name="Anthropic Claude", type="llm", enabled=false, priority=3) to providers
    add ProviderConfig(id="groq", name="Groq", type="llm", enabled=false, priority=4, notes="Szybkie inference") to providers
    add ProviderConfig(id="deepl", name="DeepL", type="translate", enabled=true, priority=1, notes="Najlepsze tłumaczenia") to providers
    add ProviderConfig(id="google-translate", name="Google Translate", type="translate", enabled=false, priority=2) to providers
    add ProviderConfig(id="whisper", name="Whisper (local/HF)", type="stt", enabled=true, priority=1) to providers
    add ProviderConfig(id="elevenlabs", name="ElevenLabs", type="tts", enabled=false, priority=2) to providers
    add ProviderConfig(id="local-tts", name="System TTS", type="tts", enabled=true, isDefault=true, priority=1) to providers
    save providers

function seedDefaultProfile()
  if profile is none
    set profile = AccessibilityProfile(
      preferredInput = "text",
      preferredOutput = "text",
      morseWpm = 15,
      vibrationStrength = 70,
      textScale = 1.0,
      highContrast = false,
      reduceMotion = false,
      ttsVoice = "default",
      ttsRate = 1.0,
      ttsPitch = 1.0,
      autoTranslate = true,
      showOriginalAndTranslation = true,
      confirmBeforeSend = true,
      showConfidence = true,
      largeTargets = true,
      musicAsEmotion = true,
      autoPlayIncoming = true,
      screenReaderHints = true
    )
    save profile

function seedDefaultSettings()
  if settings is none
    set settings = AppSettings(
      themeMode = "system",
      language = "pl",
      autoTranslate = true,
      defaultTargetLang = "en",
      musicProvider = "suno",
      llmProvider = "puter",
      translateProvider = "deepl",
      notificationsEnabled = true,
      soundEnabled = true,
      vibrationEnabled = true,
      analyticsEnabled = false
    )
    save settings

// ------------------------------------------------------------
// ONBOARDING + PERSONA
// ------------------------------------------------------------
screen Onboarding
  title "AXBridge"
  state step Number = 1

  column
    padding 24
    gap 24
    align center

    if step is 1
      column
        gap 18
        align center
        image "logo-axbridge.svg"
          width 88
          height 88
          alt "Logo AXBridge"
          animate appear
            from opacity 0
            to opacity 1
            duration 400ms
        text "AXBridge"
          style title
        text "Komunikator dla każdego. Tekst, mowa, Morse, migowy, muzyka i zabawa."
          color muted
          align center
          max width 320
        button "Zaczynamy"
          style buttonPrimary
          width full
          height 56
          when tapped set step = 2

    if step is 2
      column
        gap 14
        text "Kim jesteś?"
          style heading
          align center
        text "Dzięki temu aplikacja od razu ustawi najlepsze domyślne opcje."
          color muted
          align center

        button "Głuchy / Głucha"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deaf"
            set profile.preferredInput = "sign"
            set profile.preferredOutput = "text"
            set step = 3

        button "Niemy / Niema"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "mute"
            set profile.preferredInput = "text"
            set profile.preferredOutput = "speech"
            set step = 3

        button "Głuchoniemy / Głuchoniema"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deafMute"
            set profile.preferredInput = "sign"
            set profile.preferredOutput = "text"
            set step = 3

        button "Niewidomy / Niewidoma"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "blind"
            set profile.preferredInput = "speech"
            set profile.preferredOutput = "speech"
            set profile.musicAsEmotion = true
            set step = 3

        button "Głuchoniewidomy"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deafBlind"
            set profile.preferredInput = "morse"
            set profile.preferredOutput = "morse"
            set step = 3

        button "Ograniczona sprawność ruchowa"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "motor"
            set profile.largeTargets = true
            set step = 3

        button "Ogólny / Chcę wszystko"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "general"
            set step = 3

    if step is 3
      column
        gap 16
        text "Język i tłumaczenie"
          style heading
        text "Piszesz po polsku — kolega ze Stanów dostaje od razu po angielsku (i odwrotnie)."
          color muted

        segmented settings.defaultTargetLang
          options pl, en, auto
          labels "Polski", "English", "Auto"

        toggle profile.autoTranslate
          label "Tłumacz wiadomości automatycznie"

        toggle profile.showOriginalAndTranslation
          label "Pokazuj oryginał + tłumaczenie"

        button "Dalej"
          style buttonPrimary
          width full
          height 56
          when tapped
            save profile
            save settings
            set step = 4

    if step is 4
      column
        gap 16
        align center
        text "Muzyka jako emocja"
          style heading
        text "Możesz wysyłać utwory, generować muzykę (Suno v6 / Puter) i używać jej jako reakcji emocjonalnej."
          color muted
          align center
        toggle profile.musicAsEmotion
          label "Włącz muzykę jako kanał emocji"
        button "Przejdź do rejestracji"
          style buttonPrimary
          width full
          height 56
          when tapped
            seedProviders()
            seedDefaultProfile()
            seedDefaultSettings()
            go to Register

// ------------------------------------------------------------
// REGISTER / LOGIN
// ------------------------------------------------------------
screen Register
  title "Rejestracja"
  state displayName Text = ""
  state email Text = ""
  state password Text = ""
  state error Text = ""
  state isWorking Boolean = false

  column
    padding 24
    gap 16

    text "Utwórz konto"
      style title

    field displayName
      label "Pseudonim"
      required
      min length 2
      max length 32
      placeholder "Jak mamy Cię wyświetlać?"

    field email
      label "E-mail"
      type email
      required
      placeholder "jan@email.com"

    field password
      label "Hasło"
      type password
      required
      min length 8
      error "Minimum 8 znaków"

    if error is not empty
      text error
        color danger
        role alert

    button "Zarejestruj się"
      style buttonPrimary
      width full
      height 56
      disabled isWorking
      when tapped
        if displayName is empty or email is empty or password is empty
          set error = "Uzupełnij wszystkie pola"
        else if length of password < 8
          set error = "Hasło musi mieć co najmniej 8 znaków"
        else
          set error = ""
          set isWorking = true
          set currentUser = User(
            id = newId(),
            publicId = "AXB-" + randomCode(6),
            email = email,
            displayName = displayName,
            publicKey = "pk_" + newId(),
            persona = currentPersona,
            preferredLang = "pl",
            isAdmin = (email is "axelgadomski@icloud.com"),
            createdAt = now()
          )
          set isLoggedIn = true
          set isAdminMode = currentUser.isAdmin
          save user
          set isWorking = false
          go to MainTabs

    button "Mam już konto — zaloguj się"
      style buttonSecondary
      when tapped go to Login

screen Login
  title "Logowanie"
  state email Text = ""
  state password Text = ""
  state error Text = ""
  state isWorking Boolean = false

  column
    padding 24
    gap 16
    text "Zaloguj się"
      style title

    field email
      label "E-mail"
      type email
      required

    field password
      label "Hasło"
      type password
      required

    if error is not empty
      text error
        color danger
        role alert

    button "Zaloguj"
      style buttonPrimary
      width full
      height 56
      disabled isWorking
      when tapped
        if email is empty or password is empty
          set error = "Podaj e-mail i hasło"
        else
          set isWorking = true
          // W produkcji: weryfikacja + załadowanie usera z backendu
          // Tutaj symulacja udanego logowania
          set currentUser = User(
            id = newId(),
            publicId = "AXB-LOGIN",
            email = email,
            displayName = left(email, 8),
            publicKey = "pk_loaded",
            persona = currentPersona,
            preferredLang = "pl",
            isAdmin = (email is "axelgadomski@icloud.com"),
            createdAt = now()
          )
          set isLoggedIn = true
          set isAdminMode = currentUser.isAdmin
          save user
          set isWorking = false
          go to MainTabs

    button "Nie mam konta"
      style buttonSecondary
      when tapped go to Register

// ------------------------------------------------------------
// MAIN TAB BAR
// ------------------------------------------------------------
screen MainTabs
  tab Conversations title "Rozmowy" icon "chat"
  tab Communities title "Społeczności" icon "people"
  tab TikTak title "TikTak" icon "sparkles"
  tab MusicHub title "Muzyka" icon "music"
  tab ProfileHub title "Profil" icon "person"

// ------------------------------------------------------------
// CONVERSATIONS
// ------------------------------------------------------------
screen Conversations
  title "Rozmowy"
  state searchQuery Text = ""
  state filter Text = "all"

  when screen appears
    load conversations
    load contacts
    load providers
    set isSyncing = true
    wait 400ms
    set isSyncing = false

  column
    row
      padding 16 16 8 16
      text "AXBridge"
        style title
      spacer
      if isSyncing
        spinner size small
      button icon "search"
        accessibility label "Szukaj"
      button icon "settings"
        accessibility label "Ustawienia"
        when tapped go to SettingsHub
      button icon "alert"
        accessibility label "Tryb Pomoc"
        color danger
        when tapped go to Emergency

    field searchQuery
      label "Szukaj"
      placeholder "Szukaj kontaktu lub wiadomości…"
      icon left "search"
      clearable

    row
      padding 0 16
      gap 8
      chip "Wszystkie" selected filter is "all" when tapped set filter = "all"
      chip "Nieprzeczytane" selected filter is "unread" when tapped set filter = "unread"
      chip "Przypięte" selected filter is "pinned" when tapped set filter = "pinned"

    list conversations
      empty
        column
          padding 48 24
          gap 16
          align center
          text "Brak rozmów"
            style heading
          text "Dodaj kontakt albo dołącz do społeczności."
            color muted
            align center
          button "Dodaj kontakt"
            style buttonPrimary
            when tapped go to AddContact
      item conv
        if (filter is "all") or (filter is "unread" and conv.unreadCount > 0) or (filter is "pinned" and conv.isPinned)
          conversationRow conv
            when tapped
              set activeConversation = conv
              go to Chat(conv)

    floatingButton icon "edit"
      accessibility label "Nowa rozmowa"
      when tapped go to AddContact

component conversationRow(conv Conversation)
  card
    padding 14 16
    animate press
      scale 0.98
      duration 100ms
    row
      gap 14
      avatar conv.participants.first size 48
      column
        gap 2
        row
          text conv.participants.first.displayName
            style heading
            max lines 1
          spacer
          if conv.lastMessage is not none
            text formatRelative(conv.lastMessage.createdAt)
              style caption
        row
          if conv.lastMessage is not none
            text previewMessage(conv.lastMessage)
              color muted
              max lines 1
          spacer
          if conv.unreadCount > 0
            badge conv.unreadCount
              background primary
              color white

// ------------------------------------------------------------
// CHAT — pełny wielokanałowy + tłumaczenie
// ------------------------------------------------------------
screen Chat(conversation Conversation)
  title conversation.participants.first.displayName
  state inputMode Text = profile.preferredInput
  state draft Text = ""
  state morseBuffer Text = ""
  state isRecording Boolean = false
  state signCandidates List<Text> = []
  state signConfidence Number = 0
  state selectedCandidate Text = ""
  state replyTo Message? = none
  state isSending Boolean = false

  when screen appears
    load messages where conversationId = conversation.id
    markAsRead(conversation.id)

  column
    row
      padding 8 12
      button icon "back"
        accessibility label "Wróć"
        when tapped go back
      avatar conversation.participants.first size 36
      column
        text conversation.participants.first.displayName
          style heading
        text if translationOn then "Tłumaczenie włączone" else "Tłumaczenie wyłączone"
          style caption
          color if translationOn then success else muted
      spacer
      toggle translationOn
        accessibility label "Włącz lub wyłącz tłumaczenie na żywo"

    list messages where conversationId = conversation.id
      reverse true
      item msg
        messageBubble msg

    if replyTo is not none
      row
        padding 8 12
        background surface2
        text "Odpowiedź: " + previewMessage(replyTo)
          max lines 1
          grow true
        button icon "close"
          when tapped set replyTo = none

    row
      padding 6 10
      gap 6
      modeChip "Tekst" "text" inputMode
      modeChip "Mowa" "speech" inputMode
      modeChip "Morse" "morse" inputMode
      modeChip "Migowy" "sign" inputMode
      modeChip "Muzyka" "music" inputMode

    // TEXT
    if inputMode is "text"
      row
        padding 8 12
        gap 8
        field draft
          label "Wiadomość"
          placeholder "Napisz po polsku…"
          multiline
          max lines 5
          grow true
        button icon "send"
          accessibility label "Wyślij"
          disabled draft is empty or isSending
          when tapped
            set isSending = true
            sendTranslatedText(draft, replyTo)
            set draft = ""
            set replyTo = none
            set isSending = false

    // SPEECH
    if inputMode is "speech"
      column
        padding 16
        gap 12
        align center
        text if isRecording then "Słucham…" else "Naciśnij, aby mówić"
          color muted
        button if isRecording then "Stop" else "Mów"
          style if isRecording then buttonDanger else buttonPrimary
          width 120
          height 120
          radius full
          when tapped
            if isRecording
              stopSpeechRecognition()
            else
              startSpeechRecognition()

    // MORSE
    if inputMode is "morse"
      column
        padding 12
        gap 10
        card
          text "Bufor Morse"
            style caption
          text if morseBuffer is empty then "• • •" else morseBuffer
            style mono
            font size 22
            min height 40
        row
          gap 8
          button "·"
            style buttonSecondary
            height 64
            grow true
            accessibility label "Kropka"
            when tapped
              append "." to morseBuffer
              vibrate short
          button "−"
            style buttonSecondary
            height 64
            grow true
            accessibility label "Kreska"
            when tapped
              append "-" to morseBuffer
              vibrate medium
          button "␣"
            style buttonSecondary
            height 64
            grow true
            accessibility label "Spacja"
            when tapped append " " to morseBuffer
          button "⌫"
            style buttonSecondary
            height 64
            accessibility label "Usuń"
            when tapped
              if morseBuffer is not empty
                remove last character from morseBuffer
        row
          gap 8
          button "Wyczyść"
            style buttonSecondary
            when tapped set morseBuffer = ""
          button "Wyślij"
            style buttonPrimary
            grow true
            disabled morseBuffer is empty
            when tapped
              sendMorse(morseBuffer, replyTo)
              set morseBuffer = ""
              set replyTo = none
        text "Tempo: " + profile.morseWpm + " słów/min"
          style caption
          align center

    // SIGN
    if inputMode is "sign"
      column
        padding 12
        gap 12
        cameraPreview
          height 240
          radius medium
          accessibility label "Kamera do rozpoznawania języka migowego"
          facing user

        if signCandidates is not empty
          card
            text "Rozpoznane znaki"
              style heading
            text "Pewność: " + round(signConfidence * 100) + "%"
              color if signConfidence >= 0.85 then success else if signConfidence >= 0.6 then warning else danger

            list signCandidates
              item candidate
                row
                  text candidate grow true
                  if candidate is selectedCandidate
                    text "✓" color success
                  button "Wybierz"
                    when tapped set selectedCandidate = candidate

            row
              gap 8
              button "Akceptuj i wyślij"
                style buttonPrimary
                grow true
                disabled selectedCandidate is empty
                when tapped
                  sendSign(selectedCandidate, signConfidence, replyTo)
                  set signCandidates = []
                  set selectedCandidate = ""
                  set signConfidence = 0
                  set replyTo = none
              button "Popraw"
                style buttonSecondary
                when tapped
                  set inputMode = "text"
                  set draft = selectedCandidate
              button "Anuluj"
                style buttonSecondary
                when tapped
                  set signCandidates = []
                  set selectedCandidate = ""

        button if signCandidates is empty then "Rozpocznij rozpoznawanie" else "Rozpoznaj ponownie"
          style buttonPrimary
          width full
          height 56
          when tapped
            requestCameraPermission()
            if cameraPermission is "granted"
              runSignRecognition()
            else
              show alert "Potrzebujemy dostępu do kamery."

        text "Aplikacja nigdy nie wysyła rozpoznanego znaku bez Twojego potwierdzenia."
          style caption
          align center
          color muted

    // MUSIC
    if inputMode is "music"
      column
        padding 12
        gap 10
        text "Muzyka jako wiadomość / emocja"
          style heading
        button "Generuj muzykę (Suno v6 / Puter)"
          style buttonPrimary
          width full
          height 52
          when tapped go to MusicGenerator
        button "Wybierz z pliku"
          style buttonSecondary
          width full
          when tapped pickMusicFileAndSend()
        button "Szybkie reakcje emocjonalne"
          style buttonSecondary
          width full
          when tapped showMusicReactions()
        button "Anuluj"
          when tapped set inputMode = profile.preferredInput

component messageBubble(msg Message)
  column
    padding 4 12
    align if msg.senderId is currentUser.id then end else start
    max width 85%

    card
      padding 10 14
      background if msg.senderId is currentUser.id then primary else surface2
      color if msg.senderId is currentUser.id then white else text
      radius medium
      animate appear
        from opacity 0
        from translateY 8
        to opacity 1
        to translateY 0
        duration 220ms
        curve easeOut

      if msg.type is "text"
        column
          gap 4
          text msg.body
          if msg.translatedBody is not none and profile.showOriginalAndTranslation
            text msg.translatedBody
              style caption
              opacity 0.9
              color if msg.senderId is currentUser.id then white else accent

      if msg.type is "music"
        column
          gap 6
          row
            icon "music"
            text msg.musicMeta.title weight semibold
          if msg.musicMeta.mood is not none
            text "Nastrój: " + msg.musicMeta.mood style caption
          button "Odtwórz"
            when tapped playMusic(msg.musicMeta)

      if msg.type is "morse"
        column
          gap 4
          text msg.body style mono font size 18
          text "Morse" style caption opacity 0.8

      if msg.type is "sign"
        column
          gap 4
          text msg.body weight semibold
          if msg.confidence is not none and profile.showConfidence
            text "Pewność " + round(msg.confidence * 100) + "%" style caption

      if msg.type is "image"
        image msg.mediaUrl
          width 200
          height 200
          radius small
          alt "Zdjęcie"

      if msg.type is "voice"
        row
          gap 8
          button icon "play"
            accessibility label "Odtwórz nagranie"
          text formatDuration(msg.durationMs) style caption

      if msg.type is "alarm"
        column
          gap 4
          text "POMOC" weight bold color danger
          text msg.body

      if msg.type is "system"
        text msg.body style caption align center color muted

    row
      gap 6
      text formatTime(msg.createdAt) style caption
      if msg.senderId is currentUser.id
        text statusIcon(msg.status) style caption

// ------------------------------------------------------------
// MUSIC HUB + GENERATOR
// ------------------------------------------------------------
screen MusicHub
  title "Muzyka"
  column
    padding 16
    gap 16
    text "Muzyka jako komunikat"
      style title
    button "Generuj nowy utwór"
      style buttonPrimary
      width full
      height 56
      when tapped go to MusicGenerator
    button "Moje wygenerowane"
      style buttonSecondary
      width full
      when tapped go to MyMusic
    button "Odtwarzaj z pliku"
      style buttonSecondary
      width full
      when tapped pickAndPlayLocalMusic()
    text "Szybkie reakcje emocjonalne"
      style heading
    row
      gap 8
      musicReactionChip "😊" "happy"
      musicReactionChip "😌" "calm"
      musicReactionChip "⚡" "energetic"
      musicReactionChip "😢" "sad"
      musicReactionChip "😂" "funny"
      musicReactionChip "❤️" "love"

screen MusicGenerator
  title "Generator muzyki"
  state prompt Text = ""
  state mood Text = "happy"
  state isGenerating Boolean = false
  state result MusicMeta? = none
  state selectedProvider Text = "suno"

  column
    padding 16
    gap 14
    text "Opisz utwór (Suno v6 / Puter.js / HF MusicGen)"
      style heading
    field prompt
      label "Prompt"
      placeholder "Wesoła ukulele melodia na powitanie przyjaciela"
      multiline
      max lines 4
    text "Nastrój"
    segmented mood
      options happy, calm, energetic, sad, funny, love, angry
      labels "Wesoły", "Spokojny", "Energiczny", "Smutny", "Zabawny", "Miłosny", "Gniewny"
    text "Dostawca"
    segmented selectedProvider
      options suno, puter, huggingface
      labels "Suno v6", "Puter.js", "Hugging Face"
    button if isGenerating then "Generuję…" else "Generuj muzykę"
      style buttonPrimary
      width full
      height 56
      disabled prompt is empty or isGenerating
      when tapped
        set isGenerating = true
        generateMusic(prompt, mood, selectedProvider)
        set isGenerating = false
    if result is not none
      card
        text result.title style heading
        text "Provider: " + result.provider style caption
        button "Odtwórz" when tapped playMusic(result)
        button "Wyślij jako wiadomość"
          style buttonPrimary
          when tapped
            sendMusicMessage(result)
            go back

screen MyMusic
  title "Moja muzyka"
  when screen appears
    load musicCache
  column
    padding 16
    list musicCache
      empty
        text "Brak wygenerowanych utworów." color muted
      item m
        card
          text m.title style heading
          text m.provider + " • " + (m.mood or "—") style caption
          row
            button "Odtwórz" when tapped playMusic(m)
            button "Wyślij" when tapped sendMusicMessage(m)

// ------------------------------------------------------------
// TIKTAK
// ------------------------------------------------------------
screen TikTak
  title "TikTak"
  when screen appears
    load tiktak
  column
    row
      padding 12 16
      text "TikTak" style title
      spacer
      button icon "plus"
        accessibility label "Dodaj nowy TikTak"
        when tapped go to CreateTikTak
    list tiktak
      empty
        column
          padding 48
          align center
          text "Jeszcze cicho…" style heading
          text "Wrzuć pierwszą głupotę i rozbaw innych." color muted
          button "Dodaj TikTak"
            style buttonPrimary
            when tapped go to CreateTikTak
      item post
        tiktakCard post

component tiktakCard(post TikTakPost)
  column
    gap 8
    padding 0 0 24 0
    if post.mediaType is "video" or post.mediaType is "image"
      image post.mediaUrl
        width full
        height 420
        radius medium
        alt post.caption
    if post.mediaType is "music" or post.mediaType is "audio"
      card
        height 180
        align center
        icon "music" size 48
        text post.caption
        button "Odtwórz" when tapped playMusicFromPost(post)
    row
      padding 0 12
      avatar post.author size 32
      column
        text post.author.displayName weight semibold
        text post.caption max lines 2
    row
      padding 4 12
      gap 18
      button icon "heart" label post.likes
      button icon "message" label post.comments
      button icon "share"
      spacer
      if post.isFunny
        text "😂" font size 20

screen CreateTikTak
  title "Nowy TikTak"
  state caption Text = ""
  state mediaType Text = "video"
  state isFunny Boolean = true
  column
    padding 16
    gap 14
    field caption
      label "Opis"
      placeholder "Coś głupiego i zabawnego…"
      multiline
    segmented mediaType
      options video, image, music, audio
      labels "Wideo", "Zdjęcie", "Muzyka", "Audio"
    toggle isFunny
      label "To jest głupotka / zabawa"
    button "Wybierz plik / nagraj"
      style buttonSecondary
      width full
      when tapped pickTikTakMedia(mediaType)
    button "Opublikuj"
      style buttonPrimary
      width full
      height 56
      when tapped
        publishTikTak(caption, mediaType, isFunny)
        go to TikTak

