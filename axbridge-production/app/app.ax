screen ProvidersSettings
  title "Dostawcy API"
  column
    padding 12
    gap 8
    text "Wszystkie klucze trzymane lokalnie i zaszyfrowane. Główny: Puter.js."
      color muted
      padding 0 4 12 4
    list providers
      item p
        card
          row
            column
              text p.name style heading
              text p.type + if p.notes is not none then " • " + p.notes else ""
                style caption
              if p.isDefault
                text "Domyślny" color success style caption
            spacer
            toggle p.enabled
              when changed value
                update p.enabled = value
                save providers
          if p.enabled and p.id is not "puter" and p.id is not "local-tts"
            field p.apiKey
              label "API Key / Token"
              type password
              placeholder "Wklej klucz…"
              when changed save providers
    button "Dodaj własnego dostawcę"
      style buttonSecondary
