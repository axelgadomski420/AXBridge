    toggle profile.confirmBeforeSend label "Potwierdzaj przed wysłaniem migowego"
    toggle profile.showConfidence label "Pokazuj poziom pewności"
    toggle profile.screenReaderHints label "Dodatkowe podpowiedzi czytnika"
    button "Przywróć domyślne"
      style buttonSecondary
      width full
