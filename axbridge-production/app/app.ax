// ------------------------------------------------------------
// APP ENTRY
// ------------------------------------------------------------
when app launches
  load user
  load profile
  load settings
  load providers
  load contacts
  load conversations
  if providers is empty
    seedProviders()
  if profile is none
    seedDefaultProfile()
  if settings is none
    seedDefaultSettings()
  if isLoggedIn and currentUser is not none
    set isAdminMode = currentUser.isAdmin
    go to MainTabs
  else
    go to Onboarding
