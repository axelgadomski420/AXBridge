// ============================================================
// AXBridge v3 — aplikacja społecznościowa dla wszystkich
// Jeden plik opisuje produkt: interfejs, stan, dane, dostępność.
// Zasada: AI proponuje, człowiek zatwierdza.
// ============================================================

app "AXBridge"
version "3.0.0"
language pl
supports ios android web
orientation automatic
offline first

// ------------------------------------------------------------
// MOTYW
// ------------------------------------------------------------
theme default
  follows system
  color primary #6D28D9
  color primaryDark #5B21B6
  color accent #06B6D4
  color danger #B91C1C
  color success #15803D
  color warning #B45309
  color background light #FFFFFF
  color background dark #09090B
  color surface light #F4F4F5
  color surface dark #18181B
  color text light #09090B
  color text dark #FAFAFA
  color muted light #52525B
  color muted dark #A1A1AA
  color border light #D4D4D8
  color border dark #3F3F46
  radius medium 16
  radius large 24
  font body "Inter"

// ------------------------------------------------------------
// MODELE
// ------------------------------------------------------------
data Profile
  userId Text
  handle Text
  displayName Text
  bio Text?
  languages List<Text>
  persona Text
  isVerified Boolean
  followerCount Number
  followingCount Number
  postCount Number

data Post
  id Text
  authorHandle Text
  authorName Text
  body Text
  mediaType Text
  captions Text?
  transcript Text?
  imageAlt Text?
  signGlosses Text?
  language Text
  isSimple Boolean
  likeCount Number
  commentCount Number
  myReaction Text?
  createdAt Date

data Comment
  id Text
  postId Text
  parentId Text?
  authorHandle Text
  authorName Text
  body Text
  language Text
  createdAt Date

data AccessibilityProfile
  preferredInput Text
  preferredOutput Text
  fontScale Number
  highContrast Boolean
  reduceMotion Boolean
  simpleMode Boolean
  signLanguage Text
  autoSendChannels List<Text>

// ------------------------------------------------------------
// MAGAZYNY
// ------------------------------------------------------------
store profile local
  single Profile
  key "axbridge.profile.v3"
  encrypted true

store a11y local
  single AccessibilityProfile
  key "axbridge.a11y.v3"

store feed local
  list Post
  key "axbridge.feed.v3"
  encrypted true

store draft local
  single Post
  key "axbridge.draft.v3"
  encrypted true

// ------------------------------------------------------------
// STAN GLOBALNY
// ------------------------------------------------------------
global state loggedIn Boolean = false
global state isOnline Boolean = true
global state simpleMode Boolean = false
global state fontSize Number = 1.0
global state highContrast Boolean = false
global state reduceMotion Boolean = false
global state feedFilter Text = "all"
global state lastError Text = ""
global state loading Boolean = false
global state composerOpen Boolean = false
global state draftBody Text = ""
global state draftCaptions Text = ""
global state draftAlt Text = ""
global state draftSimple Boolean = false
global state draftMedia Text = "text"
global state activePostId Text = ""

// ------------------------------------------------------------
// FUNKCJE
// ------------------------------------------------------------
function canPublishPost(mediaType Text, captions Text, alt Text) Boolean
  if mediaType is "video"
    if captions is ""
      return false
  if mediaType is "image"
    if alt is ""
      return false
  return true

function feedQuery(filter Text) Text
  if filter is "simple"
    return "/api/posts?simple=1"
  if filter is "pl"
    return "/api/posts?lang=pl"
  if filter is "en"
    return "/api/posts?lang=en"
  if filter is "de"
    return "/api/posts?lang=de"
  return "/api/posts"

// ------------------------------------------------------------
// EKRAN: ONBOARDING
// ------------------------------------------------------------
screen Onboarding
  title "AXBridge"
  state step Number = 1

  column
    padding 24
    gap 20

    if step is 1
      text "Komunikacja, która dociera do każdego"
        style title
      text "Bez reklam. Bez sprzedaży danych. AI proponuje — Ty decydujesz."
        color muted
      button
        label "Po polsku"
        height 56
        accessibility label "Wybierz język polski"
        when tapped
          set step = 2
      button
        label "English"
        height 56
        accessibility label "Choose English"
        when tapped
          set step = 2
      button
        label "Deutsch"
        height 56
        accessibility label "Deutsch wählen"
        when tapped
          set step = 2

    if step is 2
      text "Jak chcesz pisać?"
        style title
      text "Wszystko zmienisz później w Ustawieniach."
        color muted
      button
        label "Tekstem"
        height 56
        accessibility label "Wejście tekstowe"
        when tapped
          set a11y.preferredInput = "text"
          set step = 3
      button
        label "Głosem"
        height 56
        accessibility label "Wejście głosowe, mowa na tekst"
        when tapped
          set a11y.preferredInput = "voice"
          set step = 3
      button
        label "Kodem Morse'a"
        height 56
        accessibility label "Wejście Morse, wibracje"
        when tapped
          set a11y.preferredInput = "morse"
          set reduceMotion = true
          set step = 3
      button
        label "Migiem"
        height 56
        accessibility label "Wejście językiem migowym, kamera"
        when tapped
          set a11y.preferredInput = "sign"
          set step = 3

    if step is 3
      text "Jak chcesz odbierać?"
        style title
      button
        label "Czytam tekst"
        height 56
        accessibility label "Wyjście tekstowe"
        when tapped
          set a11y.preferredOutput = "text"
          set step = 4
      button
        label "Słucham"
        height 56
        accessibility label "Wyjście głosowe, czytanie na głos"
        when tapped
          set a11y.preferredOutput = "voice"
          set step = 4
      button
        label "Czuję wibracje"
        height 56
        accessibility label "Wyjście haptyczne, Morse"
        when tapped
          set a11y.preferredOutput = "vibration"
          set step = 4
      button
        label "Widzę napisy"
        height 56
        accessibility label "Wyjście napisami i transkrypcją"
        when tapped
          set a11y.preferredOutput = "captions"
          set step = 4

    if step is 4
      text "Dostosuj ekran"
        style title
      text "Możesz to zmienić w każdej chwili."
        color muted
      toggle highContrast
        label "Wysoki kontrast"
      toggle reduceMotion
        label "Ogranicz animacje"
      toggle simpleMode
        label "Tryb uproszczony"
      button
        label "Zaczynamy"
        height 60
        accessibility label "Zakończ konfigurację i przejdź do aplikacji"
        when tapped
          save a11y
          save profile
          set loggedIn = true
          go Feed

// ------------------------------------------------------------
// EKRAN: FEED
// ------------------------------------------------------------
screen Feed
  title "Przeglądaj"
  state filter Text = "all"

  column
    gap 14

    text "Dostępny dla każdego"
      style heading
    text "Wideo bez napisów nie pojawia się w tym feedzie. To nie ustawienie — to zasada."
      color muted

    row
      button
        label "Wszystko"
        height 48
        accessibility label "Filtr: wszystkie posty"
        when tapped
          set filter = "all"
          set feedFilter = "all"
          load feed
      button
        label "Proste"
        height 48
        accessibility label "Filtr: tylko treści w trybie uproszczonym"
        when tapped
          set filter = "simple"
          set feedFilter = "simple"
          load feed
      button
        label "Polski"
        height 48
        accessibility label "Filtr: posty po polsku"
        when tapped
          set filter = "pl"
          set feedFilter = "pl"
          load feed

    list feed
      aria-live polite
      item post
        card
          text post.authorName
            style heading
            accessibility label "Autor wpisu"
          text post.body
            accessibility label "Treść wpisu"
          if post.imageAlt is not ""
            text post.imageAlt
              color muted
              accessibility label "Opis obrazu"
          if post.captions is not ""
            text post.captions
              color muted
              accessibility label "Napisy do wideo"
          if post.transcript is not ""
            text post.transcript
              color muted
              accessibility label "Transkrypcja audio"
          row
            button
              label "Reakcja"
              height 48
              accessibility label "Zareaguj na wpis"
              when tapped
                set activePostId = post.id
                call api
                  path "/api/posts/{activePostId}/reaction"
                  method "PUT"
                  on success
                    show toast "Zapisano reakcję"
                  on error
                    set lastError = "Nie udało się zapisać reakcji"
            button
              label "Komentarze"
              height 48
              accessibility label "Otwórz komentarze do wpisu"
              when tapped
                set activePostId = post.id
                go Comments
            button
              label "Zgłoś"
              height 48
              accessibility label "Zgłoś wpis do moderacji"
              when tapped
                set activePostId = post.id
                call api
                  path "/api/posts/{activePostId}/report"
                  method "POST"
                  on success
                    show toast "Zgłoszenie przyjęte"
                  on error
                    set lastError = "Zgłoszenie nie zostało wysłane"

    if lastError is not ""
      text lastError
        color danger
        accessibility label "Komunikat błędu"

    button
      label "Nowy wpis"
      height 60
      accessibility label "Utwórz nowy wpis"
      when tapped
        set composerOpen = true
        go Composer

// ------------------------------------------------------------
// EKRAN: COMPOSER
// ------------------------------------------------------------
screen Composer
  title "Nowy wpis"

  column
    gap 16

    text "Co chcesz powiedzieć?"
      style heading

    field draftBody
      label "Treść wpisu"
      accessibility label "Wpisz treść wpisu"

    button
      label "Zdjęcie"
      height 48
      accessibility label "Typ wpisu: zdjęcie, wymaga opisu"
      when tapped
        set draftMedia = "image"
    button
      label "Wideo"
      height 48
      accessibility label "Typ wpisu: wideo, wymaga napisów"
      when tapped
        set draftMedia = "video"
    button
      label "Tekst"
      height 48
      accessibility label "Typ wpisu: tekst"
      when tapped
        set draftMedia = "text"

    if draftMedia is "image"
      field draftAlt
        label "Opis zdjęcia dla osób niewidomych"
        accessibility label "Opisz, co jest na zdjęciu"

    if draftMedia is "video"
      field draftCaptions
        label "Napisy do wideo"
        accessibility label "Wpisz napisy do wideo"

    toggle draftSimple
      label "Oznacz jako tekst w trybie uproszczonym"

    if draftMedia is "image"
      if draftAlt is ""
        text "Zdjęcie bez opisu nie zostanie opublikowane."
          color warning
          accessibility label "Ostrzeżenie o braku opisu"

    if draftMedia is "video"
      if draftCaptions is ""
        text "Wideo bez napisów nie zostanie opublikowane."
          color warning
          accessibility label "Ostrzeżenie o braku napisów"

    button
      label "Opublikuj"
      height 60
      accessibility label "Opublikuj wpis"
      when tapped
        set lastError = ""
        call api
          path "/api/posts"
          method "POST"
          on success
            set draftBody = ""
            set draftCaptions = ""
            set draftAlt = ""
            set composerOpen = false
            show toast "Opublikowano"
            go Feed
          on error
            set lastError = "Nie udało się opublikować. Sprawdź napisy i opis."

    if lastError is not ""
      text lastError
        color danger
        accessibility label "Komunikat błędu"

// ------------------------------------------------------------
// EKRAN: KOMENTARZE
// ------------------------------------------------------------
screen Comments
  title "Komentarze"
  state newComment Text = ""

  column
    gap 14

    list comments
      aria-live polite
      item comment
        card
          text comment.authorName
            style heading
            accessibility label "Autor komentarza"
          text comment.body
            accessibility label "Treść komentarza"

    field newComment
      label "Twój komentarz"
      accessibility label "Napisz komentarz"

    button
      label "Dodaj komentarz"
      height 56
      accessibility label "Wyślij komentarz"
      when tapped
        set lastError = ""
        call api
          path "/api/posts/{activePostId}/comments"
          method "POST"
          on success
            set newComment = ""
            show toast "Komentarz dodany"
          on error
            set lastError = "Komentarz nie został wysłany"

    if lastError is not ""
      text lastError
        color danger
        accessibility label "Komunikat błędu"

// ------------------------------------------------------------
// EKRAN: PROFIL
// ------------------------------------------------------------
screen Profile
  title "Profil"

  column
    gap 16

    text profile.displayName
      style title
      accessibility label "Nazwa profilu"
    text profile.handle
      color muted
      accessibility label "Identyfikator profilu"
    text profile.bio
      accessibility label "O mnie"

    row
      text "Obserwujący"
        accessibility label "Liczba obserwujących"
      text "Wpisy"
        accessibility label "Liczba wpisów"

    text "Twoje dane zostają na Twoim urządzeniu. Serwer widzi tylko zaszyfrowane koperty."
      color muted
      accessibility label "Informacja o prywatności"

    button
      label "Ustawienia dostępności"
      height 56
      accessibility label "Otwórz ustawienia dostępności"
      when tapped
        go Settings

    button
      label "Zapisz profil"
      height 56
      accessibility label "Zapisz profil lokalnie"
      when tapped
        save profile
        show toast "Profil zapisany"

// ------------------------------------------------------------
// EKRAN: USTAWIENIA DOSTĘPNOŚCI
// ------------------------------------------------------------
screen Settings
  title "Dostępność"

  column
    gap 16

    toggle highContrast
      label "Wysoki kontrast"
      accessibility label "Włącz wysoki kontrast"
    toggle reduceMotion
      label "Ogranicz animacje"
      accessibility label "Wyłącz animacje"
    toggle simpleMode
      label "Tryb uproszczony — duże przyciski, krótkie zdania"
      accessibility label "Włącz tryb uproszczony"

    slider fontSize
      label "Rozmiar tekstu (100–300%)"
      accessibility label "Ustaw rozmiar tekstu"

    segmented a11y.preferredInput
      options text, voice, morse, sign
      labels "Tekst", "Głos", "Morse", "Mig"

    segmented a11y.preferredOutput
      options text, voice, vibration, captions
      labels "Tekst", "Głos", "Wibracje", "Napisy"

    button
      label "Zapisz"
      height 60
      accessibility label "Zapisz ustawienia dostępności"
      when tapped
        save a11y
        show toast "Ustawienia zapisane"
        go Feed

// ------------------------------------------------------------
// EKRAN: POMOC
// ------------------------------------------------------------
screen Emergency
  title "Tryb Pomoc"

  confirm alarm
    beforeSend true
    channel "alarm"
    accessibility label "Potwierdź wysłanie alarmu do zaufanych kontaktów"

  column
    gap 16

    text "Alarm trafia tylko do zaufanych kontaktów. Lokalizacja wygasa automatycznie."
      color muted
      accessibility label "Informacja o trybie Pomoc"

    button
      label "Wezwij pomoc — 15 minut"
      height 64
      accessibility label "Wyślij alarm z lokalizacją na 15 minut"
      when tapped
        set lastError = ""
        call api
          path "/api/emergency"
          method "POST"
          on success
            show toast "Alarm wysłany"
          on error
            set lastError = "Alarm nie został wysłany"

    button
      label "Anuluj alarm"
      height 56
      accessibility label "Anuluj aktywny alarm i wyczyść lokalizację"
      when tapped
        call api
          path "/api/emergency"
          method "DELETE"
          on success
            show toast "Alarm anulowany"
          on error
            set lastError = "Nie udało się anulować"

    if lastError is not ""
      text lastError
        color danger
        accessibility label "Komunikat błędu"
