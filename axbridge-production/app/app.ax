      when tapped go to AddProvider
    button "Przywróć listę domyślną"
      style buttonSecondary
      width full
      when tapped
        clear providers
        seedProviders()

screen AddProvider
  title "Nowy dostawca"
  state name Text = ""
  state type Text = "llm"
  state apiKey Text = ""
  column
    padding 16
    gap 12
    field name
      label "Nazwa"
      required
    segmented type
      options llm, music, translate, stt, tts
      labels "LLM", "Muzyka", "Tłumaczenie", "STT", "TTS"
    field apiKey
      label "API Key"
      type password
    button "Dodaj"
      style buttonPrimary
      width full
      when tapped
        add ProviderConfig(
          id = newId(),
          name = name,
          type = type,
          apiKey = apiKey,
          enabled = true,
          isDefault = false,
          priority = 10
        ) to providers
        save providers
        go back

