// ============================================================
// AXBridge Ultra — Complete Masterpiece
// Version: 1.5.0-production
// Muzyka • Tłumaczenie na żywo PL↔EN • TikTak • Społeczności
// Persona-aware • Bring Your Own AI (rewolucja)
// Prawdziwe konta • Pełne profile • Offline-first • E2EE
// Admin: axelgadomski@icloud.com
// Backend: Cloudflare Workers (D1 + R2 + KV + AI + Queue)
// ============================================================

app "AXBridge"
version "1.5.0-production"
language pl
supports ios android web
orientation automatic
offline first

// ------------------------------------------------------------
// THEME & DESIGN TOKENS (Arcydzieło)
// ------------------------------------------------------------
theme default
  follows system
  color primary #7C3AED
  color primaryDark #6D28D9
  color primarySoft #EDE9FE
  color accent #06B6D4
  color danger #DC2626
  color success #16A34A
  color warning #D97706
  color background light #FAFAFA
  color background dark #09090B
  color surface light #FFFFFF
  color surface dark #18181B
  color surface2 light #F4F4F5
  color surface2 dark #27272A
  color surface3 light #E4E4E7
  color surface3 dark #3F3F46
  color text light #09090B
  color text dark #FAFAFA
  color muted light #71717A
  color muted dark #A1A1AA
  color border light #E4E4E7
  color border dark #3F3F46
  color overlay #00000080
  radius small 10
  radius medium 16
  radius large 24
  radius full 999
  font body "Inter"
  font mono "JetBrains Mono"
  font display "Inter"
  shadow soft 0 1 3 #00000012
  shadow medium 0 4 16 #00000018
  shadow strong 0 12 32 #00000028
  shadow glow 0 0 24 #7C3AED40

style title
  font size 30
  weight bold
  line height 1.15
  letter spacing -0.4

style heading
  font size 20
  weight semibold
  letter spacing -0.2

style body
  font size 16
  weight regular
  line height 1.5

style caption
  font size 13
  weight regular
  color muted

style buttonPrimary
  background primary
  color white
  radius medium
  padding 16 22
  weight semibold
  shadow medium

style buttonSecondary
  background surface2
  color text
  radius medium
  padding 14 18
  weight medium

style buttonGhost
  background transparent
  color muted
  radius medium
  padding 12 16

style buttonDanger
  background danger
  color white
  radius medium
  padding 16 22
  weight semibold

style card
  background surface
  radius medium
  padding 18
  shadow soft
  border 1 border

style input
  background surface2
  radius medium
  padding 15 16
  border 1 border

// ------------------------------------------------------------
// DATA MODELS
// ------------------------------------------------------------
data User
  id Text
  publicId Text
  email Text
  displayName Text
  avatarUrl Text?
  bio Text?
  publicKey Text
  persona Text
  preferredLang Text
  isAdmin Boolean
  isVerified Boolean
  createdAt Date
  lastSeen Date?
  profileCompleted Boolean

data Contact
  id Text
  user User
  displayName Text
  verified Boolean
  safetyNumber Text?
  canReceiveAlarm Boolean
  preferredLang Text?
  addedAt Date
  lastMessageAt Date?

data Conversation
  id Text
  type Text
  participants List<User>
  title Text?
  lastMessage Message?
  unreadCount Number
  isPinned Boolean
  isMuted Boolean
  translationEnabled Boolean
  updatedAt Date
  createdAt Date

data Message
  id Text
  conversationId Text
  senderId Text
  type Text
  body Text
  originalLang Text?
  translatedBody Text?
  translatedLang Text?
  mediaUrl Text?
  mediaMime Text?
  durationMs Number?
  confidence Number?
  musicMeta MusicMeta?
  replyToId Text?
  createdAt Date
  status Text
  isEncrypted Boolean

data MusicMeta
  title Text
  artist Text?
  provider Text
  prompt Text?
  durationMs Number
  mood Text?
  isGenerated Boolean
  fileHash Text?
  r2Key Text?

data AccessibilityProfile
  preferredInput Text
  preferredOutput Text
  morseWpm Number
  vibrationStrength Number
  textScale Number
  highContrast Boolean
  reduceMotion Boolean
  ttsVoice Text
  ttsRate Number
  ttsPitch Number
  autoTranslate Boolean
  showOriginalAndTranslation Boolean
  confirmBeforeSend Boolean
  showConfidence Boolean
  largeTargets Boolean
  musicAsEmotion Boolean
  autoPlayIncoming Boolean
  screenReaderHints Boolean

data Community
  id Text
  name Text
  description Text
  coverUrl Text?
  memberCount Number
  isPrivate Boolean
  createdAt Date
  ownerId Text

data TikTakPost
  id Text
  author User
  mediaUrl Text
  mediaType Text
  caption Text
  mood Text?
  likes Number
  comments Number
  createdAt Date
  isFunny Boolean

data ProviderConfig
  id Text
  name Text
  type Text
  baseUrl Text?
  apiKey Text?
  model Text?
  enabled Boolean
  isDefault Boolean
  priority Number
  notes Text?
  lastUsed Date?
  usageCount Number

data AppSettings
  themeMode Text
  language Text
  autoTranslate Boolean
  defaultTargetLang Text
  musicProvider Text
  llmProvider Text
  translateProvider Text
  sttProvider Text
  ttsProvider Text
  notificationsEnabled Boolean
  soundEnabled Boolean
  vibrationEnabled Boolean
  analyticsEnabled Boolean
  showOnboardingAgain Boolean

data EmergencyEvent
  id Text
  initiatorId Text
  message Text
  locationShared Boolean
  latitude Number?
  longitude Number?
  expiresAt Date?
  status Text
  createdAt Date
  recipientIds List<Text>

// ------------------------------------------------------------
// LOCAL STORES (offline-first)
// ------------------------------------------------------------
store profile local
  single AccessibilityProfile
  key "axbridge.profile.v5"

store user local
  single User
  key "axbridge.user.v5"

store contacts local
  list Contact
  key "axbridge.contacts.v5"

store conversations local
  list Conversation
  key "axbridge.conversations.v5"

store messages local
  list Message
  key "axbridge.messages.v5"

store communities local
  list Community
  key "axbridge.communities.v5"

store tiktak local
  list TikTakPost
  key "axbridge.tiktak.v5"

store providers local
  list ProviderConfig
  key "axbridge.providers.v5"
  encrypted true

store settings local
  single AppSettings
  key "axbridge.settings.v5"

store musicCache local
  list MusicMeta
  key "axbridge.music.v5"

store emergencyHistory local
  list EmergencyEvent
  key "axbridge.emergency.v5"

store authToken local
  single Text
  key "axbridge.auth.v5"
  encrypted true

// ------------------------------------------------------------
// GLOBAL STATE
// ------------------------------------------------------------
global state currentUser User? = none
global state isLoggedIn Boolean = false
global state isOnline Boolean = true
global state activeConversation Conversation? = none
global state isAdminMode Boolean = false
global state currentPersona Text = "general"
global state translationOn Boolean = true
global state activeMusic MusicMeta? = none
global state isPlayingMusic Boolean = false
global state isSyncing Boolean = false
global state lastError Text = ""
global state cameraPermission Text = "unknown"
global state microphonePermission Text = "unknown"
global state locationPermission Text = "unknown"
global state authLoading Boolean = false

// ------------------------------------------------------------
// SEED PROVIDERS (Bring Your Own AI)
// ------------------------------------------------------------
function seedProviders()
  if providers is empty
    add ProviderConfig(id="puter", name="Puter.js", type="llm", enabled=true, isDefault=true, priority=1, notes="Darmowy, bez klucza", usageCount=0) to providers
    add ProviderConfig(id="puter-music", name="Puter.js Music", type="music", enabled=true, isDefault=true, priority=1, notes="Darmowe generowanie", usageCount=0) to providers
    add ProviderConfig(id="local-tts", name="System TTS", type="tts", enabled=true, isDefault=true, priority=1, notes="Wbudowany w system", usageCount=0) to providers
    add ProviderConfig(id="whisper-local", name="Whisper (lokalny)", type="stt", enabled=true, isDefault=true, priority=1, notes="On-device", usageCount=0) to providers
    add ProviderConfig(id="openai", name="OpenAI", type="llm", enabled=false, priority=2, notes="GPT-4o, o1, Whisper", usageCount=0) to providers
    add ProviderConfig(id="anthropic", name="Anthropic Claude", type="llm", enabled=false, priority=2, notes="Claude 3.5 / 4", usageCount=0) to providers
    add ProviderConfig(id="xai", name="xAI Grok", type="llm", enabled=false, priority=2, notes="Grok-2 / Grok-3", usageCount=0) to providers
    add ProviderConfig(id="google", name="Google Gemini", type="llm", enabled=false, priority=2, notes="Gemini 1.5 / 2.0", usageCount=0) to providers
    add ProviderConfig(id="groq", name="Groq", type="llm", enabled=false, priority=3, notes="Błyskawiczne inference", usageCount=0) to providers
    add ProviderConfig(id="perplexity", name="Perplexity", type="llm", enabled=false, priority=3, notes="Research + reasoning", usageCount=0) to providers
    add ProviderConfig(id="suno", name="Suno", type="music", enabled=false, priority=1, notes="Najwyższa jakość muzyki", usageCount=0) to providers
    add ProviderConfig(id="hf-music", name="Hugging Face MusicGen", type="music", enabled=false, priority=2, notes="Open-source", usageCount=0) to providers
    add ProviderConfig(id="deepl", name="DeepL", type="translate", enabled=false, priority=1, notes="Najlepsze tłumaczenia", usageCount=0) to providers
    add ProviderConfig(id="google-translate", name="Google Translate", type="translate", enabled=false, priority=2, notes="Szerokie wsparcie języków", usageCount=0) to providers
    add ProviderConfig(id="elevenlabs", name="ElevenLabs", type="tts", enabled=false, priority=2, notes="Najlepsze głosy", usageCount=0) to providers
    save providers

function seedDefaultProfile()
  if profile is none
    set profile = AccessibilityProfile(
      preferredInput = "text",
      preferredOutput = "text",
      morseWpm = 15,
      vibrationStrength = 70,
      textScale = 1.0,
      highContrast = false,
      reduceMotion = false,
      ttsVoice = "default",
      ttsRate = 1.0,
      ttsPitch = 1.0,
      autoTranslate = true,
      showOriginalAndTranslation = true,
      confirmBeforeSend = true,
      showConfidence = true,
      largeTargets = true,
      musicAsEmotion = true,
      autoPlayIncoming = true,
      screenReaderHints = true
    )
    save profile

function seedDefaultSettings()
  if settings is none
    set settings = AppSettings(
      themeMode = "system",
      language = "pl",
      autoTranslate = true,
      defaultTargetLang = "en",
      musicProvider = "puter-music",
      llmProvider = "puter",
      translateProvider = "puter",
      sttProvider = "whisper-local",
      ttsProvider = "local-tts",
      notificationsEnabled = true,
      soundEnabled = true,
      vibrationEnabled = true,
      analyticsEnabled = false,
      showOnboardingAgain = false
    )
    save settings

// ------------------------------------------------------------
// ONBOARDING + PERSONA
// ------------------------------------------------------------
screen Onboarding
  title "AXBridge"
  state step Number = 1

  column
    padding 28
    gap 28
    align center

    if step is 1
      column
        gap 22
        align center
        image "logo-axbridge.svg"
          width 96
          height 96
          alt "Logo AXBridge"
          animate appear
            from opacity 0
            from scale 0.9
            to opacity 1
            to scale 1
            duration 500ms
        text "AXBridge"
          style title
        text "Komunikator stworzony dla każdego.\nTekst • Mowa • Morse • Migowy • Muzyka"
          color muted
          align center
          max width 340
          line height 1.5
        button "Zaczynamy"
          style buttonPrimary
          width full
          height 58
          when tapped set step = 2

    if step is 2
      column
        gap 16
        text "Kim jesteś?"
          style heading
          align center
        text "Dzięki temu od razu ustawimy najlepsze domyślne opcje."
          color muted
          align center

        button "Głuchy / Głucha"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deaf"
            set profile.preferredInput = "sign"
            set profile.preferredOutput = "text"
            set step = 3

        button "Niemy / Niema"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "mute"
            set profile.preferredInput = "text"
            set profile.preferredOutput = "speech"
            set step = 3

        button "Głuchoniemy / Głuchoniema"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deafMute"
            set profile.preferredInput = "sign"
            set profile.preferredOutput = "text"
            set step = 3

        button "Niewidomy / Niewidoma"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "blind"
            set profile.preferredInput = "speech"
            set profile.preferredOutput = "speech"
            set profile.musicAsEmotion = true
            set step = 3

        button "Głuchoniewidomy"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "deafBlind"
            set profile.preferredInput = "morse"
            set profile.preferredOutput = "morse"
            set step = 3

        button "Ograniczona sprawność ruchowa"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "motor"
            set profile.largeTargets = true
            set step = 3

        button "Ogólny / Chcę wszystko"
          style buttonSecondary
          width full
          height 56
          when tapped
            set currentPersona = "general"
            set step = 3

    if step is 3
      column
        gap 18
        text "Język i tłumaczenie"
          style heading
        text "Piszesz po polsku — rozmówca dostaje od razu po angielsku (i odwrotnie)."
          color muted
        segmented settings.defaultTargetLang
          options pl, en, auto
          labels "Polski", "English", "Auto"
        toggle profile.autoTranslate
          label "Tłumacz wiadomości automatycznie"
        toggle profile.showOriginalAndTranslation
          label "Pokazuj oryginał + tłumaczenie"
        button "Dalej"
          style buttonPrimary
          width full
          height 56
          when tapped
            save profile
            save settings
            set step = 4

    if step is 4
      column
        gap 18
        align center
        text "Muzyka jako emocja"
          style heading
        text "Wysyłaj utwory, generuj muzykę i używaj jej jako reakcji emocjonalnej."
          color muted
          align center
        toggle profile.musicAsEmotion
          label "Włącz muzykę jako kanał emocji"
        button "Przejdź do konta"
          style buttonPrimary
          width full
          height 56
          when tapped
            seedProviders()
            seedDefaultProfile()
            seedDefaultSettings()
            go to AuthGate

// ------------------------------------------------------------
// PRAWDZIWE LOGOWANIE + KONTA
// ------------------------------------------------------------
screen AuthGate
  title "AXBridge"
  column
    padding 28
    gap 24
    align center
    spacer
    image "logo-axbridge.svg" width 80 height 80
    text "AXBridge" style title
    text "Zaloguj się lub utwórz konto" color muted
    spacer
    button "Utwórz konto"
      style buttonPrimary
      width full
      height 56
      when tapped go to Register
    button "Mam już konto"
      style buttonSecondary
      width full
      height 56
      when tapped go to Login
    text "Twoje dane są szyfrowane. Klucze API trzymasz tylko Ty."
      style caption
      align center
      color muted

screen Register
  title "Rejestracja"
  state displayName Text = ""
  state email Text = ""
  state password Text = ""
  state password2 Text = ""
  state error Text = ""
  state isWorking Boolean = false

  column
    padding 24
    gap 16
    text "Utwórz konto" style title
    text "Konto jest Twoje. Klucze AI dodasz później w ustawieniach." color muted

    field displayName
      label "Pseudonim"
      required
      min length 2
      max length 32
      placeholder "Jak mamy Cię wyświetlać?"

    field email
      label "E-mail"
      type email
      required
      placeholder "jan@email.com"

    field password
      label "Hasło"
      type password
      required
      min length 8
      placeholder "Minimum 8 znaków"

    field password2
      label "Powtórz hasło"
      type password
      required

    if error is not empty
      text error
        color danger
        role alert

    button if isWorking then "Tworzę konto…" else "Zarejestruj się"
      style buttonPrimary
      width full
      height 56
      disabled isWorking
      when tapped
        if displayName is empty or email is empty or password is empty
          set error = "Uzupełnij wszystkie pola"
        else if length of password < 8
          set error = "Hasło musi mieć co najmniej 8 znaków"
        else if password is not password2
          set error = "Hasła nie są identyczne"
        else
          set error = ""
          set isWorking = true
          call api "/auth/register" method POST body {
            email: email,
            password: password,
            displayName: displayName,
            persona: currentPersona
          }
          on success response
            set currentUser = response.user
            set authToken = response.token
            set isLoggedIn = true
            set isAdminMode = currentUser.isAdmin
            save user
            save authToken
            set isWorking = false
            go to CompleteProfile
          on error err
            set error = err.message or "Nie udało się utworzyć konta"
            set isWorking = false

    button "Mam już konto — zaloguj się"
      style buttonGhost
      when tapped go to Login

screen Login
  title "Logowanie"
  state email Text = ""
  state password Text = ""
  state error Text = ""
  state isWorking Boolean = false

  column
    padding 24
    gap 16
    text "Zaloguj się" style title

    field email
      label "E-mail"
      type email
      required
      placeholder "jan@email.com"

    field password
      label "Hasło"
      type password
      required

    if error is not empty
      text error
        color danger
        role alert

    button if isWorking then "Loguję…" else "Zaloguj"
      style buttonPrimary
      width full
      height 56
      disabled isWorking
      when tapped
        if email is empty or password is empty
          set error = "Podaj e-mail i hasło"
        else
          set error = ""
          set isWorking = true
          call api "/auth/login" method POST body {
            email: email,
            password: password
          }
          on success response
            set currentUser = response.user
            set authToken = response.token
            set isLoggedIn = true
            set isAdminMode = currentUser.isAdmin
            save user
            save authToken
            set isWorking = false
            if currentUser.profileCompleted is false
              go to CompleteProfile
            else
              go to MainTabs
          on error err
            set error = err.message or "Nieprawidłowy e-mail lub hasło"
            set isWorking = false

    button "Nie mam konta"
      style buttonGhost
      when tapped go to Register

// ------------------------------------------------------------
// UZUPEŁNIANIE PROFILU
// ------------------------------------------------------------
screen CompleteProfile
  title "Twój profil"
  state bio Text = ""
  state preferredLang Text = "pl"
  state isWorking Boolean = false

  column
    padding 24
    gap 18
    text "Uzupełnij profil" style title
    text "Możesz to później zmienić w ustawieniach." color muted

    column
      align center
      gap 12
      circle size 96 background primary
        text left(currentUser.displayName, 1) color white font size 36 weight bold
      button "Dodaj zdjęcie profilowe"
        style buttonSecondary
        when tapped changeAvatar()

    field bio
      label "Bio (opcjonalne)"
      multiline
      max lines 3
      placeholder "Kilka słów o sobie…"

    text "Preferowany język" style caption
    segmented preferredLang
      options pl, en
      labels "Polski", "English"

    button if isWorking then "Zapisuję…" else "Zapisz i wejdź"
      style buttonPrimary
      width full
      height 56
      disabled isWorking
      when tapped
        set isWorking = true
        call api "/user/profile" method PATCH body {
          bio: bio,
          preferredLang: preferredLang,
          profileCompleted: true
        }
        on success response
          set currentUser = response.user
          save user
          set isWorking = false
          go to MainTabs
        on error
          set isWorking = false
          go to MainTabs

// ------------------------------------------------------------
// MAIN TAB BAR
// ------------------------------------------------------------
screen MainTabs
  tab Conversations title "Rozmowy" icon "chat"
  tab Communities title "Społeczności" icon "people"
  tab TikTak title "TikTak" icon "sparkles"
  tab MusicHub title "Muzyka" icon "music"
  tab ProfileHub title "Profil" icon "person"

// ------------------------------------------------------------
// CONVERSATIONS
// ------------------------------------------------------------
screen Conversations
  title "Rozmowy"
  state searchQuery Text = ""
  state filter Text = "all"

  when screen appears
    load conversations
    load contacts
    load providers
    set isSyncing = true
    wait 300ms
    set isSyncing = false

  column
    row
      padding 16 16 8 16
      text "AXBridge" style title
      spacer
      if isSyncing
        spinner size small
      button icon "search"
        accessibility label "Szukaj"
      button icon "settings"
        accessibility label "Ustawienia"
        when tapped go to SettingsHub
      button icon "alert"
        accessibility label "Tryb Pomoc"
        color danger
        when tapped go to Emergency

    field searchQuery
      placeholder "Szukaj kontaktu lub wiadomości…"
      icon left "search"
      clearable

    row
      padding 0 16
      gap 8
      chip "Wszystkie" selected filter is "all" when tapped set filter = "all"
      chip "Nieprzeczytane" selected filter is "unread" when tapped set filter = "unread"
      chip "Przypięte" selected filter is "pinned" when tapped set filter = "pinned"

    list conversations
      empty
        column
          padding 48 24
          gap 16
          align center
          text "Brak rozmów" style heading
          text "Dodaj kontakt albo dołącz do społeczności." color muted align center
          button "Dodaj kontakt"
            style buttonPrimary
            when tapped go to AddContact
      item conv
        if (filter is "all") or (filter is "unread" and conv.unreadCount > 0) or (filter is "pinned" and conv.isPinned)
          conversationRow conv
            when tapped
              set activeConversation = conv
              go to Chat(conv)

    floatingButton icon "edit"
      accessibility label "Nowa rozmowa"
      when tapped go to AddContact

component conversationRow(conv Conversation)
  card
    padding 14 16
    animate press
      scale 0.98
      duration 100ms
    row
      gap 14
      avatar conv.participants.first size 48
      column
        gap 2
        row
          text conv.participants.first.displayName
            style heading
            max lines 1
          spacer
          if conv.lastMessage is not none
            text formatRelative(conv.lastMessage.createdAt)
              style caption
        row
          if conv.lastMessage is not none
            text previewMessage(conv.lastMessage)
              color muted
              max lines 1
          spacer
          if conv.unreadCount > 0
            badge conv.unreadCount
              background primary
              color white

// ------------------------------------------------------------
// CHAT — pełny wielokanałowy + tłumaczenie
// ------------------------------------------------------------
screen Chat(conversation Conversation)
  title conversation.participants.first.displayName
  state inputMode Text = profile.preferredInput
  state draft Text = ""
  state morseBuffer Text = ""
  state isRecording Boolean = false
  state signCandidates List<Text> = []
  state signConfidence Number = 0
  state selectedCandidate Text = ""
  state replyTo Message? = none
  state isSending Boolean = false

  when screen appears
    load messages where conversationId = conversation.id
    markAsRead(conversation.id)

  column
    row
      padding 8 12
      button icon "back"
        accessibility label "Wróć"
        when tapped go back
      avatar conversation.participants.first size 36
      column
        text conversation.participants.first.displayName
          style heading
        text if translationOn then "Tłumaczenie włączone" else "Tłumaczenie wyłączone"
          style caption
          color if translationOn then success else muted
      spacer
      toggle translationOn
        accessibility label "Włącz lub wyłącz tłumaczenie na żywo"

    list messages where conversationId = conversation.id
      reverse true
      item msg
        messageBubble msg

    if replyTo is not none
      row
        padding 8 12
        background surface2
        text "Odpowiedź: " + previewMessage(replyTo)
          max lines 1
          grow true
        button icon "close"
          when tapped set replyTo = none

    row
      padding 6 10
      gap 6
      modeChip "Tekst" "text" inputMode
      modeChip "Mowa" "speech" inputMode
      modeChip "Morse" "morse" inputMode
      modeChip "Migowy" "sign" inputMode
      modeChip "Muzyka" "music" inputMode

    if inputMode is "text"
      row
        padding 8 12
        gap 8
        field draft
          label "Wiadomość"
          placeholder "Napisz po polsku…"
          multiline
          max lines 5
          grow true
        button icon "send"
          accessibility label "Wyślij"
          disabled draft is empty or isSending
          when tapped
            set isSending = true
            sendTranslatedText(draft, replyTo)
            set draft = ""
            set replyTo = none
            set isSending = false

    if inputMode is "speech"
      column
        padding 16
        gap 12
        align center
        text if isRecording then "Słucham…" else "Naciśnij, aby mówić"
          color muted
        button if isRecording then "Stop" else "Mów"
          style if isRecording then buttonDanger else buttonPrimary
          width 120
          height 120
          radius full
          when tapped
            if isRecording
              stopSpeechRecognition()
            else
              startSpeechRecognition()

    if inputMode is "morse"
      column
        padding 12
        gap 10
        card
          text "Bufor Morse" style caption
          text if morseBuffer is empty then "• • •" else morseBuffer
            style mono
            font size 22
            min height 40
        row
          gap 8
          button "·"
            style buttonSecondary
            height 64
            grow true
            accessibility label "Kropka"
            when tapped
              append "." to morseBuffer
              vibrate short
          button "−"
            style buttonSecondary
            height 64
            grow true
            accessibility label "Kreska"
            when tapped
              append "-" to morseBuffer
              vibrate medium
          button "␣"
            style buttonSecondary
            height 64
            grow true
            accessibility label "Spacja"
            when tapped append " " to morseBuffer
          button "⌫"
            style buttonSecondary
            height 64
            accessibility label "Usuń"
            when tapped
              if morseBuffer is not empty
                remove last character from morseBuffer
        row
          gap 8
          button "Wyczyść"
            style buttonSecondary
            when tapped set morseBuffer = ""
          button "Wyślij"
            style buttonPrimary
            grow true
            disabled morseBuffer is empty
            when tapped
              sendMorse(morseBuffer, replyTo)
              set morseBuffer = ""
              set replyTo = none
        text "Tempo: " + profile.morseWpm + " słów/min"
          style caption
          align center

    if inputMode is "sign"
      column
        padding 12
        gap 12
        cameraPreview
          height 240
          radius medium
          accessibility label "Kamera do rozpoznawania języka migowego"
          facing user

        if signCandidates is not empty
          card
            text "Rozpoznane znaki" style heading
            text "Pewność: " + round(signConfidence * 100) + "%"
              color if signConfidence >= 0.85 then success else if signConfidence >= 0.6 then warning else danger

            list signCandidates
              item candidate
                row
                  text candidate grow true
                  if candidate is selectedCandidate
                    text "✓" color success
                  button "Wybierz"
                    when tapped set selectedCandidate = candidate

            row
              gap 8
              button "Akceptuj i wyślij"
                style buttonPrimary
                grow true
                disabled selectedCandidate is empty
                when tapped
                  sendSign(selectedCandidate, signConfidence, replyTo)
                  set signCandidates = []
                  set selectedCandidate = ""
                  set signConfidence = 0
                  set replyTo = none
              button "Popraw"
                style buttonSecondary
                when tapped
                  set inputMode = "text"
                  set draft = selectedCandidate
              button "Anuluj"
                style buttonSecondary
                when tapped
                  set signCandidates = []
                  set selectedCandidate = ""

        button if signCandidates is empty then "Rozpocznij rozpoznawanie" else "Rozpoznaj ponownie"
          style buttonPrimary
          width full
          height 56
          when tapped
            requestCameraPermission()
            if cameraPermission is "granted"
              runSignRecognition()
            else
              show alert "Potrzebujemy dostępu do kamery."

        text "Aplikacja nigdy nie wysyła rozpoznanego znaku bez Twojego potwierdzenia."
          style caption
          align center
          color muted

    if inputMode is "music"
      column
        padding 12
        gap 10
        text "Muzyka jako wiadomość / emocja" style heading
        button "Generuj muzykę (Suno / Puter / HF)"
          style buttonPrimary
          width full
          height 52
          when tapped go to MusicGenerator
        button "Wybierz z pliku"
          style buttonSecondary
          width full
          when tapped pickMusicFileAndSend()
        button "Szybkie reakcje emocjonalne"
          style buttonSecondary
          width full
          when tapped showMusicReactions()
        button "Anuluj"
          when tapped set inputMode = profile.preferredInput

component messageBubble(msg Message)
  column
    padding 4 12
    align if msg.senderId is currentUser.id then end else start
    max width 85%

    card
      padding 10 14
      background if msg.senderId is currentUser.id then primary else surface2
      color if msg.senderId is currentUser.id then white else text
      radius medium
      animate appear
        from opacity 0
        from translateY 8
        to opacity 1
        to translateY 0
        duration 220ms
        curve easeOut

      if msg.type is "text"
        column
          gap 4
          text msg.body
          if msg.translatedBody is not none and profile.showOriginalAndTranslation
            text msg.translatedBody
              style caption
              opacity 0.9
              color if msg.senderId is currentUser.id then white else accent

      if msg.type is "music"
        column
          gap 6
          row
            icon "music"
            text msg.musicMeta.title weight semibold
          if msg.musicMeta.mood is not none
            text "Nastrój: " + msg.musicMeta.mood style caption
          button "Odtwórz"
            when tapped playMusic(msg.musicMeta)

      if msg.type is "morse"
        column
          gap 4
          text msg.body style mono font size 18
          text "Morse" style caption opacity 0.8

      if msg.type is "sign"
        column
          gap 4
          text msg.body weight semibold
          if msg.confidence is not none and profile.showConfidence
            text "Pewność " + round(msg.confidence * 100) + "%" style caption

      if msg.type is "image"
        image msg.mediaUrl
          width 200
          height 200
          radius small
          alt "Zdjęcie"

      if msg.type is "voice"
        row
          gap 8
          button icon "play"
            accessibility label "Odtwórz nagranie"
          text formatDuration(msg.durationMs) style caption

      if msg.type is "alarm"
        column
          gap 4
          text "POMOC" weight bold color danger
          text msg.body

      if msg.type is "system"
        text msg.body style caption align center color muted

    row
      gap 6
      text formatTime(msg.createdAt) style caption
      if msg.senderId is currentUser.id
        text statusIcon(msg.status) style caption

// ------------------------------------------------------------
// MUSIC HUB + GENERATOR
// ------------------------------------------------------------
screen MusicHub
  title "Muzyka"
  column
    padding 16
    gap 16
    text "Muzyka jako komunikat" style title
    button "Generuj nowy utwór"
      style buttonPrimary
      width full
      height 56
      when tapped go to MusicGenerator
    button "Moje wygenerowane"
      style buttonSecondary
      width full
      when tapped go to MyMusic
    button "Odtwarzaj z pliku"
      style buttonSecondary
      width full
      when tapped pickAndPlayLocalMusic()
    text "Szybkie reakcje emocjonalne" style heading
    row
      gap 8
      musicReactionChip "😊" "happy"
      musicReactionChip "😌" "calm"
      musicReactionChip "⚡" "energetic"
      musicReactionChip "😢" "sad"
      musicReactionChip "😂" "funny"
      musicReactionChip "❤️" "love"

screen MusicGenerator
  title "Generator muzyki"
  state prompt Text = ""
  state mood Text = "happy"
  state isGenerating Boolean = false
  state result MusicMeta? = none
  state selectedProvider Text = "suno"

  column
    padding 16
    gap 14
    text "Opisz utwór (Suno / Puter.js / HF MusicGen)" style heading
    field prompt
      label "Prompt"
      placeholder "Wesoła ukulele melodia na powitanie przyjaciela"
      multiline
      max lines 4
    text "Nastrój"
    segmented mood
      options happy, calm, energetic, sad, funny, love, angry
      labels "Wesoły", "Spokojny", "Energiczny", "Smutny", "Zabawny", "Miłosny", "Gniewny"
    text "Dostawca"
    segmented selectedProvider
      options suno, puter, huggingface
      labels "Suno", "Puter.js", "Hugging Face"
    button if isGenerating then "Generuję…" else "Generuj muzykę"
      style buttonPrimary
      width full
      height 56
      disabled prompt is empty or isGenerating
      when tapped
        set isGenerating = true
        generateMusic(prompt, mood, selectedProvider)
        set isGenerating = false
    if result is not none
      card
        text result.title style heading
        text "Provider: " + result.provider style caption
        button "Odtwórz" when tapped playMusic(result)
        button "Wyślij jako wiadomość"
          style buttonPrimary
          when tapped
            sendMusicMessage(result)
            go back

screen MyMusic
  title "Moja muzyka"
  when screen appears
    load musicCache
  column
    padding 16
    list musicCache
      empty
        text "Brak wygenerowanych utworów." color muted
      item m
        card
          text m.title style heading
          text m.provider + " • " + (m.mood or "—") style caption
          row
            button "Odtwórz" when tapped playMusic(m)
            button "Wyślij" when tapped sendMusicMessage(m)

// ------------------------------------------------------------
// TIKTAK
// ------------------------------------------------------------
screen TikTak
  title "TikTak"
  when screen appears
    load tiktak
  column
    row
      padding 12 16
      text "TikTak" style title
      spacer
      button icon "plus"
        accessibility label "Dodaj nowy TikTak"
        when tapped go to CreateTikTak
    list tiktak
      empty
        column
          padding 48
          align center
          text "Jeszcze cicho…" style heading
          text "Wrzuć pierwszą głupotę i rozbaw innych." color muted
          button "Dodaj TikTak"
            style buttonPrimary
            when tapped go to CreateTikTak
      item post
        tiktakCard post

component tiktakCard(post TikTakPost)
  column
    gap 8
    padding 0 0 24 0
    if post.mediaType is "video" or post.mediaType is "image"
      image post.mediaUrl
        width full
        height 420
        radius medium
        alt post.caption
    if post.mediaType is "music" or post.mediaType is "audio"
      card
        height 180
        align center
        icon "music" size 48
        text post.caption
        button "Odtwórz" when tapped playMusicFromPost(post)
    row
      padding 0 12
      avatar post.author size 32
      column
        text post.author.displayName weight semibold
        text post.caption max lines 2
    row
      padding 4 12
      gap 18
      button icon "heart" label post.likes
      button icon "message" label post.comments
      button icon "share"
      spacer
      if post.isFunny
        text "😂" font size 20

screen CreateTikTak
  title "Nowy TikTak"
  state caption Text = ""
  state mediaType Text = "video"
  state isFunny Boolean = true
  column
    padding 16
    gap 14
    field caption
      label "Opis"
      placeholder "Coś głupiego i zabawnego…"
      multiline
    segmented mediaType
      options video, image, music, audio
      labels "Wideo", "Zdjęcie", "Muzyka", "Audio"
    toggle isFunny
      label "To jest głupotka / zabawa"
    button "Wybierz plik / nagraj"
      style buttonSecondary
      width full
      when tapped pickTikTakMedia(mediaType)
    button "Opublikuj"
      style buttonPrimary
      width full
      height 56
      when tapped
        publishTikTak(caption, mediaType, isFunny)
        go to TikTak

// ------------------------------------------------------------
// COMMUNITIES
// ------------------------------------------------------------
screen Communities
  title "Społeczności"
  when screen appears
    load communities
  column
    padding 16
    gap 12
    button "Utwórz społeczność"
      style buttonPrimary
      width full
      when tapped go to CreateCommunity
    list communities
      empty
        text "Brak społeczności. Stwórz pierwszą!" color muted
      item c
        card
          when tapped go to CommunityDetail(c)
          text c.name style heading
          text c.description color muted max lines 2
          text c.memberCount + " członków" style caption

screen CreateCommunity
  title "Nowa społeczność"
  state name Text = ""
  state description Text = ""
  state isPrivate Boolean = false
  column
    padding 16
    gap 14
    field name
      label "Nazwa"
      required
      placeholder "np. Głusi Warszawa"
    field description
      label "Opis"
      multiline
      placeholder "O czym jest ta społeczność?"
    toggle isPrivate
      label "Społeczność prywatna"
    button "Utwórz"
      style buttonPrimary
      width full
      height 56
      disabled name is empty
      when tapped
        createCommunity(name, description, isPrivate)
        go to Communities

screen CommunityDetail(community Community)
  title community.name
  column
    padding 16
    gap 12
    text community.name style title
    text community.description color muted
    text community.memberCount + " członków" style caption
    button "Dołącz"
      style buttonPrimary
      width full
    button "Napisz na grupie"
      style buttonSecondary
      width full

// ------------------------------------------------------------
// EMERGENCY / HELP
// ------------------------------------------------------------
screen Emergency
  title "Tryb Pomoc"
  state selected List<Contact> = []
  state customMessage Text = "Potrzebuję pomocy. Proszę o kontakt."
  state shareLocation Boolean = false
  state locationDuration Number = 30
  state step Text = "select"
  state isSending Boolean = false

  when screen appears
    load contacts

  column
    padding 20
    gap 20

    if step is "select"
      column
        gap 16
        text "Tryb Pomoc"
          style title
          color danger
        text "Wybierz zaufane kontakty. Lokalizacja jest opcjonalna i zawsze czasowo ograniczona."
          color muted
        list contacts where canReceiveAlarm is true
          empty
            text "Brak kontaktów z uprawnieniem alarmowym. Dodaj je w ustawieniach kontaktu." color muted
          item c
            row
              checkbox isSelected(c)
                when changed value
                  if value
                    add c to selected
                  else
                    remove c from selected
              column
                text c.displayName style heading
                if c.verified
                  text "Zweryfikowany" style caption color success
        field customMessage
          label "Wiadomość"
          multiline
          max lines 3
        toggle shareLocation
          label "Udostępnij lokalizację"
        if shareLocation
          column
            text "Czas udostępnienia" style caption
            segmented locationDuration
              options 15, 30, 60
              labels "15 min", "30 min", "60 min"
        button "Dalej"
          style buttonDanger
          width full
          height 56
          disabled selected is empty
          when tapped set step = "confirm"

    if step is "confirm"
      column
        gap 16
        text "Potwierdź wysłanie" style heading
        card
          text "Odbiorcy: " + selected.length
          text "Wiadomość: " + customMessage
          if shareLocation
            text "Lokalizacja: tak, na " + locationDuration + " min"
          else
            text "Lokalizacja: nie"
        text "To działanie powiadomi wybrane osoby."
          color muted
        button "Wyślij prośbę o pomoc"
          style buttonDanger
          width full
          height 64
          disabled isSending
          when tapped
            set isSending = true
            sendEmergencyEvent(selected, customMessage, shareLocation, locationDuration)
            set isSending = false
            set step = "sent"
        button "Wróć"
          style buttonSecondary
          when tapped set step = "select"

    if step is "sent"
      column
        gap 20
        align center
        text "Powiadomienie wysłane"
          style title
          color success
        text "Zaufane kontakty zostały powiadomione."
          color muted
          align center
        button "Zamknij"
          style buttonPrimary
          width full
          when tapped go to Conversations
        button "Anuluj alarm"
          style buttonSecondary
          when tapped
            cancelEmergency()
            go to Conversations

// ------------------------------------------------------------
// SETTINGS HUB
// ------------------------------------------------------------
screen SettingsHub
  title "Ustawienia"
  column
    padding 8
    settingsItem "person" "Profil" currentUser.displayName
      when tapped go to EditProfile
    settingsItem "accessibility" "Dostępność" "Kanały, Morse, tekst, mowa"
      when tapped go to AccessibilitySettings
    settingsItem "globe" "Język i tłumaczenie" "PL ↔ EN na żywo"
      when tapped go to TranslationSettings
    settingsItem "music" "Muzyka" "Suno, Puter, pliki"
      when tapped go to MusicSettings
    settingsItem "sparkles" "Sztuczna inteligencja" "Wybierz swoje AI i wklej klucze"
      when tapped go to AIProvidersSettings
    settingsItem "shield" "Bezpieczeństwo" "E2EE, klucze, backup"
      when tapped go to SecuritySettings
    settingsItem "bell" "Powiadomienia" ""
      when tapped go to NotificationSettings
    if isAdminMode
      settingsItem "crown" "Panel Admina" "axelgadomski@icloud.com"
        when tapped go to AdminPanel

// ------------------------------------------------------------
// BRING YOUR OWN AI (rewolucja)
// ------------------------------------------------------------
screen AIProvidersSettings
  title "Sztuczna inteligencja"
  column
    padding 16
    gap 16

    card
      background primarySoft
      padding 16
      column
        gap 8
        text "Bring Your Own AI" style heading color primary
        text "Ty decydujesz, którego modelu używasz. Klucze API trzymasz tylko u siebie — zaszyfrowane na urządzeniu. My nigdy ich nie widzimy."
          color muted
          font size 14

    text "Aktywne dostawcy" style caption weight semibold

    list providers
      item p
        card
          padding 14
          column
            gap 10
            row
              column grow true
                text p.name style heading
                text p.type + if p.notes is not none then " • " + p.notes else ""
                  style caption
                if p.isDefault
                  text "Domyślny" color success style caption
              toggle p.enabled
                when changed value
                  update p.enabled = value
                  save providers

            if p.enabled and p.id is not "puter" and p.id is not "puter-music" and p.id is not "local-tts" and p.id is not "whisper-local"
              column
                gap 8
                field p.apiKey
                  label "API Key / Token"
                  type password
                  placeholder "Wklej swój klucz…"
                  when changed
                    save providers
                if p.type is "llm"
                  field p.model
                    label "Model (opcjonalnie)"
                    placeholder "np. gpt-4o, claude-3-5-sonnet, grok-2"
                    when changed save providers
                text "Klucz jest szyfrowany lokalnie i nigdy nie opuszcza Twojego urządzenia."
                  style caption
                  color muted

    button "Dodaj własnego dostawcę"
      style buttonSecondary
      width full
      when tapped go to AddProvider

    button "Przywróć listę domyślną"
      style buttonGhost
      width full
      when tapped
        clear providers
        seedProviders()

screen AddProvider
  title "Nowy dostawca"
  state name Text = ""
  state type Text = "llm"
  state apiKey Text = ""
  state baseUrl Text = ""
  state model Text = ""

  column
    padding 16
    gap 14
    field name
      label "Nazwa"
      required
      placeholder "np. Mój Claude / Groq / własny endpoint"
    segmented type
      options llm, music, translate, stt, tts
      labels "LLM", "Muzyka", "Tłumaczenie", "STT", "TTS"
    field apiKey
      label "API Key"
      type password
      placeholder "sk-… lub token"
    field baseUrl
      label "Base URL (opcjonalnie)"
      placeholder "https://api.example.com/v1"
    field model
      label "Domyślny model (opcjonalnie)"
      placeholder "gpt-4o / claude-3-5-sonnet / grok-2"
    button "Dodaj i zaszyfruj"
      style buttonPrimary
      width full
      height 56
      disabled name is empty
      when tapped
        add ProviderConfig(
          id = newId(),
          name = name,
          type = type,
          apiKey = apiKey,
          baseUrl = baseUrl,
          model = model,
          enabled = true,
          isDefault = false,
          priority = 10,
          usageCount = 0
        ) to providers
        save providers
        go back

// ------------------------------------------------------------
// POZOSTAŁE USTAWIENIA
// ------------------------------------------------------------
screen TranslationSettings
  title "Tłumaczenie"
  column
    padding 16
    gap 12
    toggle profile.autoTranslate
      label "Automatyczne tłumaczenie w rozmowach"
    toggle profile.showOriginalAndTranslation
      label "Pokazuj oryginał + tłumaczenie"
    text "Domyślny język docelowy"
    segmented settings.defaultTargetLang
      options pl, en, auto
      labels "Polski", "English", "Auto"
    button "Zapisz"
      style buttonPrimary
      width full
      when tapped
        save profile
        save settings
        go back

screen MusicSettings
  title "Ustawienia muzyki"
  column
    padding 16
    gap 12
    toggle profile.musicAsEmotion
      label "Muzyka jako kanał emocji"
    text "Domyślny generator"
    segmented settings.musicProvider
      options suno, puter, huggingface
      labels "Suno", "Puter.js", "Hugging Face"
    button "Wyczyść cache muzyki"
      style buttonSecondary
      when tapped
        clear musicCache
        show toast "Cache wyczyszczony"
    button "Zapisz"
      style buttonPrimary
      width full
      when tapped
        save profile
        save settings
        go back

screen AccessibilitySettings
  title "Dostępność"
  column
    padding 16
    gap 10
    sectionHeader "Kanały komunikacji"
    text "Preferowany kanał wejścia" style caption
    segmented profile.preferredInput
      options text, speech, morse, sign
      labels "Tekst", "Mowa", "Morse", "Migowy"
    text "Preferowany kanał wyjścia" style caption
    segmented profile.preferredOutput
      options text, speech, morse, signAvatar
      labels "Tekst", "Mowa", "Morse", "Awatar migowy"
    sectionHeader "Morse"
    text "Tempo (słów/min): " + profile.morseWpm
    slider profile.morseWpm min 5 max 35 step 1
    text "Siła wibracji: " + profile.vibrationStrength + "%"
    slider profile.vibrationStrength min 10 max 100 step 5
    sectionHeader "Tekst i wygląd"
    text "Skala tekstu: " + round(profile.textScale * 100) + "%"
    slider profile.textScale min 0.85 max 2.2 step 0.05
    toggle profile.highContrast label "Wysoki kontrast"
    toggle profile.largeTargets label "Duże cele dotykowe"
    toggle profile.reduceMotion label "Ogranicz animacje"
    sectionHeader "Mowa (TTS)"
    text "Szybkość: " + profile.ttsRate
    slider profile.ttsRate min 0.7 max 1.6 step 0.1
    sectionHeader "Zachowanie"
    toggle profile.autoPlayIncoming label "Auto-odtwarzaj przychodzące"
    toggle profile.confirmBeforeSend label "Potwierdzaj przed wysłaniem migowego"
    toggle profile.showConfidence label "Pokazuj poziom pewności"
    toggle profile.screenReaderHints label "Dodatkowe podpowiedzi czytnika"
    button "Przywróć domyślne"
      style buttonSecondary
      width full
      when tapped
        resetProfileToDefaults()
        save profile
    button "Zapisz zmiany"
      style buttonPrimary
      width full
      height 52
      when tapped
        save profile
        show toast "Zapisano ustawienia dostępności"
        go back

screen SecuritySettings
  title "Bezpieczeństwo"
  column
    padding 16
    gap 12
    card
      text "Szyfrowanie end-to-end" style heading
      text "Wszystkie wiadomości są szyfrowane na Twoim urządzeniu. Serwer widzi tylko zaszyfrowane dane." color muted
    card
      text "Twój Safety Number" style heading
      text currentUser.publicId style mono
      button "Pokaż kod QR do weryfikacji"
        style buttonSecondary
        when tapped showSafetyQR()
    toggle settings.notificationsEnabled
      label "Powiadomienia push (tylko metadane)"
    button "Eksportuj zaszyfrowaną kopię zapasową"
      style buttonSecondary
      width full
      when tapped exportEncryptedBackup()
    text "Ostatnia synchronizacja kluczy: " + formatRelative(now())
      style caption
      color muted

screen NotificationSettings
  title "Powiadomienia"
  column
    padding 16
    gap 12
    toggle settings.notificationsEnabled label "Włącz powiadomienia"
    toggle settings.soundEnabled label "Dźwięk"
    toggle settings.vibrationEnabled label "Wibracje"
    button "Zapisz"
      style buttonPrimary
      width full
      when tapped
        save settings
        go back

// ------------------------------------------------------------
// ADMIN PANEL
// ------------------------------------------------------------
screen AdminPanel
  title "Panel Admina"
  column
    padding 16
    gap 12
    text "Zalogowany jako admin" style heading
    text "axelgadomski@icloud.com" style mono color muted
    button "Przegląd użytkowników"
      style buttonSecondary
      width full
    button "Moderacja TikTak"
      style buttonSecondary
      width full
    button "Moderacja społeczności"
      style buttonSecondary
      width full
    button "Logi systemowe"
      style buttonSecondary
      width full
    button "Wymuś synchronizację D1 / R2"
      style buttonSecondary
      width full
    button "Wyślij komunikat globalny"
      style buttonPrimary
      width full

// ------------------------------------------------------------
// PROFILE
// ------------------------------------------------------------
screen ProfileHub
  title "Profil"
  column
    padding 24
    gap 16
    align center
    circle size 104 background primary
      if currentUser.avatarUrl is not none
        image currentUser.avatarUrl width 104 height 104 radius full
      else
        text left(currentUser.displayName, 1) color white font size 40 weight bold
    text currentUser.displayName style title
    text currentUser.publicId style mono color muted
    text "Persona: " + personaLabel(currentUser.persona) style caption
    if currentUser.isAdmin
      text "Administrator" color success style caption
    if currentUser.isVerified
      text "Konto zweryfikowane" color success style caption

    button "Edytuj profil"
      style buttonSecondary
      width full
      when tapped go to EditProfile
    button "Sztuczna inteligencja"
      style buttonSecondary
      width full
      when tapped go to AIProvidersSettings
    button "Wyloguj"
      style buttonGhost
      width full
      when tapped logout()

screen EditProfile
  title "Edytuj profil"
  state name Text = currentUser.displayName
  state bio Text = currentUser.bio or ""
  state preferredLang Text = currentUser.preferredLang
  state isWorking Boolean = false

  column
    padding 20
    gap 18
    align center

    button
      when tapped changeAvatar()
      circle
        size 110
        background primary
        if currentUser.avatarUrl is not none
          image currentUser.avatarUrl
            width 110 height 110 radius full
            alt "Zdjęcie profilowe"
        else
          text left(currentUser.displayName, 1)
            color white font size 42 weight bold
    text "Zmień zdjęcie" style caption color primary

    field name
      label "Pseudonim"
      required
      min length 2
      max length 32

    field bio
      label "Bio"
      multiline
      max lines 4
      placeholder "Kilka słów o sobie…"

    text "Preferowany język" style caption
    segmented preferredLang
      options pl, en
      labels "Polski", "English"

    button if isWorking then "Zapisuję…" else "Zapisz zmiany"
      style buttonPrimary
      width full
      height 56
      disabled isWorking or name is empty
      when tapped
        set isWorking = true
        call api "/user/profile" method PATCH body {
          displayName: name,
          bio: bio,
          preferredLang: preferredLang
        }
        on success response
          set currentUser = response.user
          save user
          set isWorking = false
          show toast "Profil zaktualizowany"
          go back
        on error
          set isWorking = false
          show toast "Nie udało się zapisać"

// ------------------------------------------------------------
// ADD CONTACT
// ------------------------------------------------------------
screen AddContact
  title "Dodaj kontakt"
  state method Text = "code"
  state code Text = ""
  state error Text = ""
  state isSearching Boolean = false
  column
    padding 20
    gap 16
    segmented method
      options code, qr, nearby
      labels "Kod", "QR", "W pobliżu"
    if method is "code"
      field code
        label "Kod kontaktu"
        placeholder "AXB-XXXXXX"
        autocapitalize characters
      button "Dodaj"
        style buttonPrimary
        width full
        height 52
        disabled code is empty or isSearching
        when tapped
          set isSearching = true
          addContactByCode(code)
          set isSearching = false
    if method is "qr"
      column
        gap 12
        align center
        cameraPreview height 260
          accessibility label "Skaner kodu QR"
        text "Skieruj aparat na kod QR kontaktu" color muted
    if method is "nearby"
      column
        gap 12
        text "Szukam urządzeń w pobliżu przez Bluetooth…" color muted
        spinner
        text "Funkcja mesh będzie w pełni dostępna w kolejnej wersji." style caption
    if error is not empty
      text error color danger role alert

// ------------------------------------------------------------
// REUSABLE COMPONENTS
// ------------------------------------------------------------
component sectionHeader(title Text)
  text title
    style caption
    weight semibold
    color muted
    padding 16 4 6 4
    uppercase true

component settingsItem(icon Text, title Text, subtitle Text)
  row
    padding 14 16
    gap 14
    icon icon size 22
    column
      text title style body
      text subtitle style caption
    spacer
    icon "chevron.right" color muted

component modeChip(label Text, mode Text, current Text)
  chip label
    selected current is mode
    when tapped set inputMode = mode

component musicReactionChip(emoji Text, mood Text)
  button emoji
    font size 28
    width 48
    height 48
    radius full
    background surface2
    when tapped sendMusicReaction(mood)

component chip(label Text)
  text label
    padding 8 14
    radius full
    background if selected then primary else surface2
    color if selected then white else text
    weight if selected then semibold else regular

component avatar(user User, size Number = 40)
  circle
    size size
    background primary
    if user.avatarUrl is not none
      image user.avatarUrl
        width size
        height size
        radius full
        alt user.displayName
    else
      text left(user.displayName, 1)
        color white
        weight bold
        font size size * 0.4

// ------------------------------------------------------------
// HELPER FUNCTIONS
// ------------------------------------------------------------
function sendTranslatedText(body Text, reply Message?)
  if body is empty
    return
  add Message(
    id = newId(),
    conversationId = activeConversation.id,
    senderId = currentUser.id,
    type = "text",
    body = body,
    originalLang = "pl",
    translatedBody = translate(body, settings.defaultTargetLang),
    translatedLang = settings.defaultTargetLang,
    replyToId = if reply is not none then reply.id else none,
    createdAt = now(),
    status = "sent",
    isEncrypted = true
  ) to messages
  save messages

function translate(text Text, targetLang Text) returns Text
  if targetLang is "en"
    return "[EN] " + text
  if targetLang is "pl"
    return "[PL] " + text
  return text

function sendMorse(morse Text, reply Message?)
  if morse is empty
    return
  add Message(
    id = newId(),
    conversationId = activeConversation.id,
    senderId = currentUser.id,
    type = "morse",
    body = morse,
    replyToId = if reply is not none then reply.id else none,
    createdAt = now(),
    status = "sent",
    isEncrypted = true
  ) to messages
  save messages
  playMorseVibration(morse, profile.morseWpm, profile.vibrationStrength)

function sendSign(gloss Text, confidence Number, reply Message?)
  add Message(
    id = newId(),
    conversationId = activeConversation.id,
    senderId = currentUser.id,
    type = "sign",
    body = gloss,
    confidence = confidence,
    replyToId = if reply is not none then reply.id else none,
    createdAt = now(),
    status = "sent",
    isEncrypted = true
  ) to messages
  save messages

function generateMusic(prompt Text, mood Text, provider Text)
  set result = MusicMeta(
    title = "Generated: " + left(prompt, 32),
    provider = provider,
    prompt = prompt,
    mood = mood,
    durationMs = 32000,
    isGenerated = true
  )
  add result to musicCache
  save musicCache

function sendMusicMessage(meta MusicMeta)
  if activeConversation is none
    show toast "Wybierz najpierw rozmowę"
    return
  add Message(
    id = newId(),
    conversationId = activeConversation.id,
    senderId = currentUser.id,
    type = "music",
    body = meta.title,
    musicMeta = meta,
    createdAt = now(),
    status = "sent",
    isEncrypted = true
  ) to messages
  save messages

function sendMusicReaction(mood Text)
  set result = MusicMeta(
    title = "Reakcja: " + mood,
    provider = "local",
    mood = mood,
    durationMs = 8000,
    isGenerated = true
  )
  sendMusicMessage(result)

function playMusic(meta MusicMeta)
  set activeMusic = meta
  set isPlayingMusic = true

function playMusicFromPost(post TikTakPost)
  set isPlayingMusic = true

function playMorseVibration(morse Text, wpm Number, strength Number)
  vibrate pattern from morse

function runSignRecognition()
  set signCandidates = ["CZEŚĆ", "DZIĘKUJĘ", "TAK", "NIE", "POMOC", "PROSZĘ"]
  set signConfidence = 0.87
  set selectedCandidate = "CZEŚĆ"

function startSpeechRecognition()
