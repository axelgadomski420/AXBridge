function runSignRecognition()
  set signCandidates = ["CZEŚĆ", "DZIĘKUJĘ", "TAK", "NIE", "POMOC", "PROSZĘ"]
  set signConfidence = 0.87
  set selectedCandidate = "CZEŚĆ"

function startSpeechRecognition()
  set isRecording = true
  requestMicrophonePermission()

function stopSpeechRecognition()
  set isRecording = false
  // Wynik STT → draft lub od razu send

function markAsRead(conversationId Text)
  // Aktualizuje statusy na read

function sendEmergencyEvent(contacts List<Contact>, message Text, withLocation Boolean, durationMin Number)
  add EmergencyEvent(
    id = newId(),
    initiatorId = currentUser.id,
    message = message,
    locationShared = withLocation,
    expiresAt = if withLocation then now() + durationMin * 60 else none,
    status = "active",
    createdAt = now(),
    recipientIds = contacts.map(c => c.id)
  ) to emergencyHistory
  save emergencyHistory
  show notification "Powiadomienie o pomocy zostało wysłane"

function cancelEmergency()
  // Anuluje aktywne zdarzenie

function createCommunity(name Text, description Text, isPrivate Boolean)
  add Community(
    id = newId(),
    name = name,
    description = description,
    memberCount = 1,
    isPrivate = isPrivate,
    createdAt = now(),
    ownerId = currentUser.id
  ) to communities
  save communities

function publishTikTak(caption Text, mediaType Text, isFunny Boolean)
  add TikTakPost(
    id = newId(),
    author = currentUser,
    mediaUrl = "r2://placeholder",
    mediaType = mediaType,
    caption = caption,
    likes = 0,
    comments = 0,
    createdAt = now(),
    isFunny = isFunny
  ) to tiktak
  save tiktak

function addContactByCode(code Text)
  if code is empty
    set error = "Wpisz kod"
    return
  show toast "Kontakt dodany (symulacja)"
  go to Conversations

