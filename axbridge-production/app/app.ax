function personaLabel(p Text) returns Text
  if p is "deaf" return "Głuchy/Głucha"
  if p is "mute" return "Niemy/Niema"
  if p is "deafMute" return "Głuchoniemy"
  if p is "blind" return "Niewidomy/Niewidoma"
  if p is "deafBlind" return "Głuchoniewidomy"
  if p is "motor" return "Ograniczona sprawność ruchowa"
  return "Ogólny"

function previewMessage(msg Message) returns Text
  if msg.type is "text" return msg.body
  if msg.type is "music" return "🎵 " + msg.musicMeta.title
  if msg.type is "morse" return "Morse: " + msg.body
  if msg.type is "sign" return "Migowy: " + msg.body
  if msg.type is "image" return "Zdjęcie"
  if msg.type is "voice" return "Wiadomość głosowa"
  if msg.type is "alarm" return "POMOC"
  return "Wiadomość"

function statusIcon(status Text) returns Text
  if status is "sending" return "○"
  if status is "sent" return "✓"
  if status is "delivered" return "✓✓"
  if status is "read" return "✓✓"
  if status is "failed" return "!"
  return ""

function formatTime(date Date) returns Text
  return timeString(date)

function formatRelative(date Date) returns Text
  return relativeString(date)

function formatDuration(ms Number) returns Text
  return durationString(ms)

function isSelected(c Contact) returns Boolean
  return c in selected

